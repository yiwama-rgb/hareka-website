---
export interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogUrl?: string;
  ogType?: string;
  currentPath?: string;
}

const {
  title,
  description,
  ogTitle,
  ogDescription,
  ogImage = 'https://hareka.io/ogp.png',
  ogUrl,
  ogType = 'website',
  currentPath,
} = Astro.props;

const canonicalUrl = ogUrl ?? new URL(Astro.url.pathname, Astro.site).toString();
const resolvedPath = currentPath ?? Astro.url.pathname;

const navLinks = [
  { href: '/services', label: 'サービス' },
  { href: '/cases',   label: '導入事例' },
  { href: '/blog',    label: 'ブログ' },
  { href: '/about',   label: '会社概要' },
];

function isActive(href: string): boolean {
  if (href === '/') return resolvedPath === '/';
  return resolvedPath.startsWith(href);
}

// 構造化データ（Organization）
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Hareka合同会社',
  url: 'https://hareka.io',
  logo: 'https://hareka.io/ogp.png',
  founder: {
    '@type': 'Person',
    name: '岩間 悠一',
    jobTitle: 'Hareka合同会社 代表',
    description: '元HubSpot Japan カスタマーサクセスマネージャー。200社以上のHubSpot導入を支援。',
  },
  sameAs: [],
};
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="icon" type="image/png" href="/favicon.png" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- OGP -->
  <meta property="og:title" content={ogTitle ?? title} />
  <meta property="og:description" content={ogDescription ?? description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Hareka" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImage} />

  <!-- 構造化データ (Organization) -->
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />

  <!-- HubSpot -->
  <script type="text/javascript" id="hs-script-loader" async defer src="//js-na2.hs-scripts.com/245774122.js"></script>

  <!-- Google Analytics 4 -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-5GB78X1H0Q"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-5GB78X1H0Q');
  </script>
</head>
<body>

<!-- HEADER -->
<header class="header" id="top">
  <div class="container">
    <div class="header__inner">
      <a href="/" class="logo" aria-label="Hareka ホーム">
        <!-- 仮ロゴ（モックアップ再現版）：確定ロゴの正式SVGパス入手後に差し替え -->
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 280 64" width="200" height="46">
          <g transform="translate(2,6)">
            <circle cx="46" cy="12" r="7" fill="#EA5425"/>
            <path d="M4 48 L22 10 L28 24 L31 18 L34 26 L40 16 L48 40 Q52 46 58 42"
                  fill="none" stroke="#1B3B47" stroke-width="4.5"
                  stroke-linecap="round" stroke-linejoin="round"/>
          </g>
          <text x="76" y="44" font-family="Outfit, 'Helvetica Neue', Arial, sans-serif" font-size="27" font-weight="500" fill="#1B3B47" letter-spacing="2">Hareka</text>
        </svg>
      </a>
      <nav class="nav" aria-label="メインナビゲーション">
        <ul class="nav__list">
          {navLinks.map(link => (
            <li>
              <a href={link.href} class={isActive(link.href) ? 'active' : ''}>
                {link.label}
              </a>
            </li>
          ))}
          <li><a href="/contact" class="nav__cta">無料相談する</a></li>
        </ul>
      </nav>
      <button class="hamburger" aria-label="メニュー" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<!-- MOBILE NAV -->
<div class="mobile-nav" aria-hidden="true">
  {navLinks.map(link => (
    <a href={link.href} class={isActive(link.href) ? 'active' : ''}>
      {link.label}
    </a>
  ))}
  <a href="/contact" class="mobile-cta">お問い合わせ</a>
</div>

<slot />

<!-- FOOTER -->
<footer class="footer">
  <div class="container">
    <div class="footer__inner">
      <div class="footer__brand">
        <!-- 仮ロゴ（モックアップ再現版・反転）：確定ロゴの正式SVGパス入手後に差し替え -->
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 280 64" width="180" height="41">
          <g transform="translate(2,6)">
            <circle cx="46" cy="12" r="7" fill="#EA5425"/>
            <path d="M4 48 L22 10 L28 24 L31 18 L34 26 L40 16 L48 40 Q52 46 58 42"
                  fill="none" stroke="#E8F0F2" stroke-width="4.5"
                  stroke-linecap="round" stroke-linejoin="round"/>
          </g>
          <text x="76" y="44" font-family="Outfit, 'Helvetica Neue', Arial, sans-serif" font-size="27" font-weight="500" fill="#FFFFFF" letter-spacing="2">Hareka</text>
        </svg>
        <p class="footer__tagline">経営の無駄を晴らす。<br />経営の不透明を晴らす。<br />最先端技術への不安を晴らす。</p>
      </div>
      <div class="footer__nav">
        <div class="footer__nav-col">
          <p class="footer__nav-title">Navigation</p>
          <ul class="footer__nav-list">
            <li><a href="/">Home</a></li>
            <li><a href="/services">Services</a></li>
            <li><a href="/cases">Cases</a></li>
            <li><a href="/about">About</a></li>
            <li><a href="/blog">Blog</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </div>
        <div class="footer__nav-col">
          <p class="footer__nav-title">Services</p>
          <ul class="footer__nav-list">
            <li><a href="/services">HubSpot 導入支援</a></li>
            <li><a href="/services">Salesforce → HubSpot 移管</a></li>
            <li><a href="/services">HubSpot 活用支援</a></li>
            <li><a href="/services">営業組織 効率化支援</a></li>
          </ul>
        </div>
      </div>
    </div>
    <div class="footer__bottom">
      <p>© 2026 Hareka LLC</p>
      <p><a href="/privacy">プライバシーポリシー</a> ・ <a href="/about">会社概要</a></p>
    </div>
  </div>
</footer>

<script src="/js/main.js" is:inline></script>
<script>
  // Scroll header
  const header = document.querySelector('.header');
  if (header) {
    window.addEventListener('scroll', () => {
      header.classList.toggle('scrolled', window.scrollY > 10);
    }, { passive: true });
  }
  // Mobile nav
  const hamburger = document.querySelector('.hamburger');
  const mobileNav = document.querySelector('.mobile-nav');
  if (hamburger && mobileNav) {
    hamburger.addEventListener('click', () => {
      hamburger.classList.toggle('open');
      mobileNav.classList.toggle('open');
      document.body.style.overflow = mobileNav.classList.contains('open') ? 'hidden' : '';
    });
    mobileNav.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        hamburger.classList.remove('open');
        mobileNav.classList.remove('open');
        document.body.style.overflow = '';
      });
    });
  }
  // Scroll reveal
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.style.opacity = '1';
        entry.target.style.transform = 'translateY(0)';
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

  document.querySelectorAll('.card, .service-card, .case-card, .why-card, .blog-card').forEach(el => {
    const htmlEl = el as HTMLElement;
    htmlEl.style.opacity = '0';
    htmlEl.style.transform = 'translateY(20px)';
    htmlEl.style.transition = 'opacity .5s ease, transform .5s ease, box-shadow .25s ease, border-color .25s ease';
    observer.observe(el);
  });
</script>
</body>
</html>
