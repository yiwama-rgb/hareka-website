---
export interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogUrl?: string;
  ogType?: string;
  currentPath?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  ogTitle,
  ogDescription,
  ogImage = 'https://hareka.io/images/og-image.png',
  ogUrl,
  ogType = 'website',
  currentPath,
  noindex = false,
} = Astro.props;

// URLは末尾スラッシュありに統一（trailingSlash: 'always' と一致させる）
function ensureTrailingSlash(url: string): string {
  return url.endsWith('/') ? url : `${url}/`;
}

const canonicalUrl = ensureTrailingSlash(
  ogUrl ?? new URL(Astro.url.pathname, Astro.site).toString()
);
const resolvedPath = ensureTrailingSlash(currentPath ?? Astro.url.pathname);

const navLinks = [
  { href: '/services/', label: 'サービス' },
  { href: '/cases/',   label: '導入事例' },
  { href: '/blog/',    label: 'ブログ' },
  { href: '/about/',   label: '会社概要' },
];

function isActive(href: string): boolean {
  if (href === '/') return resolvedPath === '/';
  return resolvedPath.startsWith(href);
}

// 構造化データ（Organization）
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Hareka合同会社',
  url: 'https://hareka.io',
  logo: 'https://hareka.io/images/logo-mark-512.png',
  founder: {
    '@type': 'Person',
    name: '岩間 悠一',
    jobTitle: 'Hareka合同会社 代表',
    description: '元HubSpot Japan カスタマーサクセスマネージャー。200社以上のHubSpot導入を支援。',
  },
  sameAs: [],
};
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="icon" href="/favicon.ico?v=2" sizes="48x48">
  <link rel="icon" href="/favicon-32.png?v=2" type="image/png" sizes="32x32">
  <link rel="icon" href="/favicon-16.png?v=2" type="image/png" sizes="16x16">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2">
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <link rel="canonical" href={canonicalUrl} />

  <!-- OGP -->
  <meta property="og:title" content={ogTitle ?? title} />
  <meta property="og:description" content={ogDescription ?? description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Hareka" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImage} />

  <!-- 構造化データ (Organization) -->
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />

  <!-- HubSpot -->
  <script type="text/javascript" id="hs-script-loader" async defer src="//js-na2.hs-scripts.com/245774122.js"></script>

  <!-- Google Analytics 4 -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-5GB78X1H0Q"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-5GB78X1H0Q');
  </script>
</head>
<body>

<!-- HEADER -->
<header class="header" id="top">
  <div class="container">
    <div class="header__inner">
      <a href="/" class="logo" aria-label="Hareka ホーム">
        <img src="/images/logo-horizontal.png" alt="Hareka" class="logo__img" width="171" height="35" />
      </a>
      <nav class="nav" aria-label="メインナビゲーション">
        <ul class="nav__list">
          {navLinks.map(link => (
            <li>
              <a href={link.href} class={isActive(link.href) ? 'active' : ''}>
                {link.label}
              </a>
            </li>
          ))}
          <li><a href="/contact/" class="nav__cta">無料相談する</a></li>
        </ul>
      </nav>
      <button class="hamburger" aria-label="メニュー" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<!-- MOBILE NAV -->
<div class="mobile-nav" aria-hidden="true">
  {navLinks.map(link => (
    <a href={link.href} class={isActive(link.href) ? 'active' : ''}>
      {link.label}
    </a>
  ))}
  <a href="/contact/" class="mobile-cta">お問い合わせ</a>
</div>

<slot />

<!-- FOOTER -->
<footer class="footer">
  <div class="container">
    <div class="footer__inner">
      <div class="footer__brand">
        <img src="/images/logo-horizontal-white.png" alt="Hareka" class="footer__logo" width="196" height="40" />
        <p class="footer__tagline">経営の視界を、クリアに。</p>
      </div>
      <div class="footer__nav">
        <div class="footer__nav-col">
          <p class="footer__nav-title">Navigation</p>
          <ul class="footer__nav-list">
            <li><a href="/">Home</a></li>
            <li><a href="/services/">Services</a></li>
            <li><a href="/cases/">Cases</a></li>
            <li><a href="/about/">About</a></li>
            <li><a href="/blog/">Blog</a></li>
            <li><a href="/contact/">Contact</a></li>
          </ul>
        </div>
        <div class="footer__nav-col">
          <p class="footer__nav-title">Services</p>
          <ul class="footer__nav-list">
            <li><a href="/services/salesforce-migration/">Salesforce → HubSpot 移行支援</a></li>
            <li><a href="/services/hubspot-reactivation/">HubSpot 再活用支援</a></li>
            <li><a href="/services/#replatform">乗せ換え・導入支援</a></li>
          </ul>
        </div>
      </div>
    </div>
    <div class="footer__bottom">
      <p>© 2026 Hareka LLC</p>
      <p><a href="/privacy/">プライバシーポリシー</a> ・ <a href="/about/">会社概要</a></p>
    </div>
  </div>
</footer>

<script src="/js/main.js" is:inline></script>
</body>
</html>
