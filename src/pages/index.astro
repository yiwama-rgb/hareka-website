---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// トップページに表示する3件（この順番で固定）
const featuredSlugs = [
  '01-salesforce-hubspot-manufacturing',       // 年間ライセンス費用50%削減（製造業向けソフトウェア）
  '02-saas-salesforce-hubspot-datamigration',  // 営業・マーケデータをHubSpotに一本化（BtoB SaaS）
  '06-investment-fund-hubspot-launch',         // Excel管理から脱却、60日でAI連携（投資ファンド）
];
const allCases = await getCollection('cases', ({ data }) => !data.draft);
const featuredCases = featuredSlugs
  .map(slug => allCases.find(c => c.slug === slug))
  .filter((c): c is NonNullable<typeof c> => Boolean(c));

// 保有資格
const hubspotCerts = [
  'インバウンド認定コース',
  'インバウンドマーケティング認定コース',
  'インバウンドセールス認定コース',
  'HubSpotマーケティングソフトウェア認定コース',
  'HubSpotセールスソフトウェア認定コース',
];
const salesforceCerts = [
  'Salesforce 認定 Platform アドミニストレーター',
  'Salesforce 認定 Platform アドミニストレーター 上級',
  'Salesforce 認定 Platform アプリケーションビルダー',
  'Salesforce 認定 Sales Cloud コンサルタント',
  'Salesforce 認定 Service Cloud コンサルタント',
];
---

<BaseLayout
  title="Hareka | HubSpot・CRM専門コンサルティング"
  description="HubSpot Japan出身・200社以上の支援経験を持つ代表が、HubSpotの導入から自走まで一貫して伴走。Salesforceからの移管、活用・定着支援まで対応します。"
  ogTitle="Hareka | 経営の視界を、クリアに。"
  ogDescription="HubSpot Japan出身・200社以上の支援経験。導入から自走まで、代表が一貫してご支援します。"
>

  <style>
    /* ===== 共通 ===== */
    .top-section {
      padding: 72px 0;
    }
    .eyebrow {
      display: block;
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 4px;
      text-transform: uppercase;
      color: var(--orange);
      margin-bottom: 14px;
    }
    .eyebrow--ja {
      letter-spacing: 0.05em;
      text-transform: none;
    }
    .top-heading {
      font-size: clamp(26px, 4vw, 34px);
      font-weight: 700;
      color: var(--text-head);
      line-height: 1.4;
      margin-bottom: 36px;
      letter-spacing: -0.01em;
    }

    /* ===== ヒーロー ===== */
    .top-hero {
      background: var(--bg-hero);
      padding: 148px 0 80px;
      border-bottom: 1px solid var(--border);
    }
    .top-hero__inner {
      max-width: 720px;
    }
    .top-hero__title {
      font-size: clamp(32px, 5vw, 48px);
      font-weight: 700;
      color: var(--text-head);
      line-height: 1.35;
      letter-spacing: -0.01em;
      margin-bottom: 24px;
    }
    .top-hero__lead {
      font-size: 16px;
      font-weight: 500;
      color: var(--text-body);
      line-height: 1.9;
      margin-bottom: 36px;
      max-width: 600px;
    }
    .top-hero__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
    }
    .top-hero__partner-badge {
      display: block;
      height: 64px;
      width: auto;
      margin-top: 40px;
    }
    .top-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 16px 32px;
      border-radius: 6px;
      font-size: 16px;
      font-weight: 700;
      line-height: 1;
      transition: background var(--transition), color var(--transition), border-color var(--transition);
    }
    .top-btn--primary {
      background: var(--orange);
      color: var(--white);
    }
    .top-btn--primary:hover {
      background: var(--orange-hover);
    }
    .top-btn--ghost {
      background: var(--white);
      color: var(--text-head);
      border: 1px solid var(--border-strong);
    }
    .top-btn--ghost:hover {
      border-color: var(--navy);
    }

    /* ===== インサイト ===== */
    .insight-band {
      background: var(--navy);
      padding: 72px 0;
    }
    .insight-band__inner {
      max-width: 820px;
    }
    .insight-band__statement {
      font-size: clamp(22px, 3.4vw, 30px);
      font-weight: 700;
      color: var(--white);
      line-height: 1.6;
      letter-spacing: -0.01em;
      margin-bottom: 22px;
    }
    .insight-band__text {
      font-size: 15.5px;
      color: rgba(255, 255, 255, 0.8);
      line-height: 1.95;
    }

    /* ===== 課題リスト ===== */
    .why-section {
      background: var(--bg-soft);
    }
    .fit-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 14px;
      max-width: 760px;
      margin-bottom: 28px;
    }
    .fit-list li {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      padding: 20px 26px;
      background: var(--white);
      border: 1px solid var(--border);
      border-left: 3px solid var(--orange);
      border-radius: var(--radius);
      font-size: 15px;
      font-weight: 500;
      color: var(--text-head);
      line-height: 1.75;
    }
    .fit-list__check {
      flex-shrink: 0;
      color: var(--orange);
      margin-top: 3px;
    }
    .fit-list__link {
      display: inline-block;
      margin-left: 8px;
      font-size: 14px;
      font-weight: 600;
      color: var(--orange);
      border-bottom: 1px solid currentColor;
      transition: opacity var(--transition);
    }
    .fit-list__link:hover { opacity: 0.75; }
    .fit-note {
      font-size: 14.5px;
      color: var(--text-body);
      line-height: 1.9;
      max-width: 760px;
    }

    /* ===== 実績数値バー ===== */
    .stats-bar {
      padding: 56px 0;
      border-bottom: 1px solid var(--border);
    }
    .stats-bar__grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
    }
    .stats-bar__item {
      text-align: center;
      padding: 8px 24px;
      border-left: 1px solid var(--border-strong);
    }
    .stats-bar__item:first-child {
      border-left: none;
    }
    .stats-bar__icon {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 46px;
      color: var(--text-head);
      margin-bottom: 6px;
    }
    .stats-bar__num {
      display: block;
      font-size: 40px;
      font-weight: 700;
      color: var(--text-head);
      line-height: 1.2;
      letter-spacing: -0.02em;
      margin-bottom: 6px;
    }
    .stats-bar__label {
      display: block;
      font-size: 13px;
      font-weight: 500;
      color: var(--text-muted);
      line-height: 1.6;
    }

    /* ===== サービス ===== */
    .services-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
    .service-item {
      display: block;
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 32px 30px;
      color: inherit;
      transition: border-color var(--transition);
    }
    .service-item:hover {
      border-color: var(--navy);
    }
    .service-item__num {
      display: block;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 2px;
      color: var(--orange);
      margin-bottom: 14px;
    }
    .service-item__title {
      font-size: 18px;
      font-weight: 600;
      color: var(--text-head);
      line-height: 1.5;
      margin-bottom: 12px;
    }
    .service-item__text {
      font-size: 15px;
      font-weight: 400;
      color: var(--text-body);
      line-height: 1.9;
    }

    /* ===== 導入事例 ===== */
    .cases-section {
      background: var(--bg-soft);
    }
    .top-cases-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      margin-bottom: 40px;
    }
    .top-case-card {
      display: flex;
      flex-direction: column;
      gap: 14px;
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 28px;
      color: inherit;
      transition: border-color var(--transition);
    }
    .top-case-card:hover {
      border-color: var(--navy);
    }
    .top-case-card__tags {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }
    .top-case-card__tag {
      display: inline-block;
      padding: 3px 12px;
      background: var(--blue-light);
      color: var(--text-head);
      border-radius: 9999px;
      font-size: 12px;
      font-weight: 600;
    }
    .top-case-card__title {
      font-size: 17px;
      font-weight: 600;
      color: var(--text-head);
      line-height: 1.6;
      flex: 1;
    }
    .top-case-card__industry {
      font-size: 13px;
      font-weight: 500;
      color: var(--text-muted);
    }
    .cases-more {
      text-align: center;
    }
    .cases-more__link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 15px;
      font-weight: 600;
      color: var(--text-head);
      border-bottom: 1px solid var(--border-strong);
      padding-bottom: 3px;
      transition: color var(--transition), border-color var(--transition);
    }
    .cases-more__link:hover {
      color: var(--orange);
      border-color: var(--orange);
    }

    /* ===== 選ばれる理由 ===== */
    .why-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 40px;
    }
    .why-item {
      border-top: 2px solid var(--navy);
      padding-top: 20px;
    }
    .why-item__icon {
      display: block;
      color: var(--text-head);
      margin-bottom: 14px;
    }
    .why-item__title {
      font-size: 18px;
      font-weight: 600;
      color: var(--text-head);
      line-height: 1.5;
      margin-bottom: 12px;
    }
    .why-item__text {
      font-size: 15px;
      font-weight: 400;
      color: var(--text-body);
      line-height: 1.9;
    }

    /* ===== 代表プロフィール ===== */
    .founder-section {
      border-top: 1px solid var(--border);
    }
    .founder-main {
      display: flex;
      gap: 40px;
      align-items: flex-start;
      margin-bottom: 48px;
    }
    .founder-photo {
      width: 120px;
      height: 120px;
      border-radius: 50%;
      object-fit: cover;
      object-position: center top;
      flex-shrink: 0;
    }
    .founder-name {
      font-size: 24px;
      font-weight: 700;
      color: var(--text-head);
      margin-bottom: 4px;
    }
    .founder-role {
      font-size: 13px;
      font-weight: 500;
      color: var(--text-muted);
      margin-bottom: 18px;
    }
    .founder-bio {
      font-size: 16px;
      font-weight: 400;
      color: var(--text-body);
      line-height: 1.9;
      margin-bottom: 22px;
      max-width: 680px;
    }
    .founder-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .founder-pill {
      display: inline-block;
      padding: 5px 14px;
      background: var(--blue-light);
      color: var(--text-head);
      border-radius: 9999px;
      font-size: 12.5px;
      font-weight: 600;
    }
    .certs {
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 32px;
    }
    .certs__heading {
      font-size: 16px;
      font-weight: 600;
      color: var(--text-head);
      margin-bottom: 20px;
    }
    .certs__grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 28px;
    }
    .certs__group-title {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-muted);
      margin-bottom: 12px;
    }
    .certs__list li {
      font-size: 14.5px;
      font-weight: 400;
      color: var(--text-body);
      line-height: 1.7;
      padding: 5px 0 5px 16px;
      position: relative;
    }
    .certs__list li::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0.95em;
      width: 5px;
      height: 5px;
      background: var(--orange);
      border-radius: 50%;
    }
    /* ===== レスポンシブ ===== */
    @media (max-width: 960px) {
      .services-grid,
      .top-cases-grid,
      .why-grid {
        grid-template-columns: 1fr;
      }
      .why-grid {
        gap: 28px;
      }
      .certs__grid {
        grid-template-columns: 1fr;
      }
    }
    @media (max-width: 768px) {
      .top-section {
        padding: 56px 0;
      }
      .top-hero {
        padding: 120px 0 56px;
      }
      .stats-bar__grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 32px 0;
      }
      .stats-bar__item {
        border-left: none;
        padding: 8px 12px;
      }
      .stats-bar__item:nth-child(even) {
        border-left: 1px solid var(--border-strong);
      }
      .founder-main {
        flex-direction: column;
        align-items: center;
        text-align: center;
      }
      .founder-pills {
        justify-content: center;
      }
      .founder-bio {
        text-align: left;
      }
      .certs {
        padding: 24px 20px;
      }
    }
  </style>

  <!-- ヒーロー -->
  <section class="top-hero">
    <div class="container">
      <div class="top-hero__inner">
        <span class="eyebrow eyebrow--ja">HubSpot認定パートナー</span>
        <h1 class="top-hero__title">HubSpotの成果に、<br />プロフェッショナルの伴走を。</h1>
        <p class="top-hero__lead">HubSpot Japan出身・200社以上の支援経験を持つ代表が、導入から自走まで一貫してご支援します。担当変更も、引き継ぎもありません。</p>
        <div class="top-hero__actions">
          <a href="/contact/" class="top-btn top-btn--primary">無料相談を予約する</a>
          <a href="/cases/" class="top-btn top-btn--ghost">導入事例を見る</a>
        </div>
        <!-- 公式パートナーバッジ（画像は後日追加。未配置の間はonerrorで非表示） -->
        <img
          src="/images/hubspot-partner-badge.png"
          alt="HubSpot認定パートナー バッジ"
          class="top-hero__partner-badge"
          height="64"
          onerror="this.style.display='none'"
        />
      </div>
    </div>
  </section>

  <!-- インサイト -->
  <section class="insight-band">
    <div class="container">
      <div class="insight-band__inner">
        <p class="insight-band__statement">CRMの成果は、どのツールを選ぶかではなく「どれだけ活用されるか」で決まります。</p>
        <p class="insight-band__text">活用には、事業に合った設計、専門知識にもとづく正しい実装、そして運用と改善のループが欠かせません。Harekaは、この3つを代表が一貫して提供するHubSpot専門コンサルティング会社です。</p>
      </div>
    </div>
  </section>

  <!-- 実績数値バー -->
  <section class="stats-bar">
    <div class="container">
      <div class="stats-bar__grid">
        <div class="stats-bar__item">
          <span class="stats-bar__icon" aria-hidden="true">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="8" r="7"/>
              <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/>
            </svg>
          </span>
          <span class="stats-bar__label">HubSpot認定パートナー</span>
        </div>
        <div class="stats-bar__item">
          <span class="stats-bar__num">200社+</span>
          <span class="stats-bar__label">支援実績</span>
        </div>
        <div class="stats-bar__item">
          <span class="stats-bar__num">8年+</span>
          <span class="stats-bar__label">CRM/SFA/MAの経験</span>
        </div>
        <div class="stats-bar__item">
          <span class="stats-bar__num">10資格</span>
          <span class="stats-bar__label">HubSpot・Salesforce認定</span>
        </div>
      </div>
    </div>
  </section>

  <!-- サービス -->
  <section class="top-section">
    <div class="container">
      <span class="eyebrow">Services</span>
      <h2 class="top-heading">支援メニュー</h2>
      <div class="services-grid">
        <a href="/services/salesforce-migration/" class="service-item">
          <span class="service-item__num">01</span>
          <h3 class="service-item__title">Salesforce → HubSpot 移行支援</h3>
          <p class="service-item__text">両ツールの深い知見をもとに、ただの移管ではなく、活用しやすい構造に再設計して納品。コスト削減と活用改善を同時に実現します。</p>
        </a>
        <a href="/services/" class="service-item">
          <span class="service-item__num">02</span>
          <h3 class="service-item__title">HubSpot 再活用支援</h3>
          <p class="service-item__text">「契約したのに使われていない」を立て直します。なぜ活用が進まないのかを分析し、何をどの順番でやるべきかを整理して、実装まで請け負います。</p>
        </a>
        <a href="/services/" class="service-item">
          <span class="service-item__num">03</span>
          <h3 class="service-item__title">Zendesk・Excel等からの乗せ換え・導入支援</h3>
          <p class="service-item__text">Zendesk、Notion、Airtable、Excelなどで管理している営業・サポート業務を、売上につながる仕組みへ。設計から実装、定着まで伴走します。</p>
        </a>
      </div>
    </div>
  </section>

  <!-- 選ばれる理由 -->
  <section class="top-section why-section">
    <div class="container">
      <span class="eyebrow">Why Hareka</span>
      <h2 class="top-heading">なぜ、Harekaなのか</h2>
      <div class="why-grid">
        <div class="why-item">
          <span class="why-item__icon" aria-hidden="true">
            <!-- award -->
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="8" r="7"/>
              <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/>
            </svg>
          </span>
          <h3 class="why-item__title">200社以上の活用支援で「使われるCRM」を知っている</h3>
          <p class="why-item__text">元HubSpot Japan シニアCSMとして200社以上の活用支援に携わり、どういうCRMが現場で使われ、どういうCRMが使われなくなるのかを見てきました。だからHarekaは、お客様が実際に使えて、成果の出るCRMを納品します。</p>
        </div>
        <div class="why-item">
          <span class="why-item__icon" aria-hidden="true">
            <!-- transfer -->
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 10h13l-4-4"/>
              <path d="M17 14H4l4 4"/>
            </svg>
          </span>
          <h3 class="why-item__title">SalesforceとHubSpot、両方の専門知識</h3>
          <p class="why-item__text">Salesforce認定資格5つとHubSpot認定資格を保有し、両ツールの深い知見があります。移行・乗せ換えの設計で「旧環境の意図を読み解けない」「新環境の仕様に合わない」という失敗が起こりません。</p>
        </div>
        <div class="why-item">
          <span class="why-item__icon" aria-hidden="true">
            <!-- briefcase -->
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
              <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
            </svg>
          </span>
          <h3 class="why-item__title">営業・カスタマーサクセスの現場を知っている</h3>
          <p class="why-item__text">キーエンス・WeWorkでの営業経験と、CSMとしての業務知識があります。ツールの設定だけでなく、営業・サポートの業務そのものを理解した上で設計します。</p>
        </div>
        <div class="why-item">
          <span class="why-item__icon" aria-hidden="true">
            <!-- user-check -->
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="9" cy="7" r="4"/>
              <path d="M3 21v-2a4 4 0 0 1 4-4h4"/>
              <path d="M15 19l2 2l4-4"/>
            </svg>
          </span>
          <h3 class="why-item__title">全案件、代表が一貫して担当</h3>
          <p class="why-item__text">営業から設計・実装・伴走まで、すべて代表が直接担当します。担当者の当たり外れも、引き継ぎによる情報の欠落もありません。</p>
        </div>
        <div class="why-item">
          <span class="why-item__icon" aria-hidden="true">
            <!-- trending-up -->
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/>
              <polyline points="17 6 23 6 23 12"/>
            </svg>
          </span>
