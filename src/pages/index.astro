---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// 数値インパクトの強い3件を表示
const featuredSlugs = [
  '04-staffing-marketinghub-launch',      // ROI 300%
  '01-salesforce-hubspot-manufacturing',  // 年間ライセンス費用50%削減
  '05-trading-marketinghub-content',      // リード月40件以上
];
const allCases = await getCollection('cases', ({ data }) => !data.draft);
const featuredCases = featuredSlugs
  .map(slug => allCases.find(c => c.slug === slug))
  .filter((c): c is NonNullable<typeof c> => Boolean(c));

// 保有資格
const hubspotCerts = [
  'インバウンド認定コース',
  'インバウンドマーケティング認定コース',
  'インバウンドセールス認定コース',
  'HubSpotマーケティングソフトウェア認定コース',
  'HubSpotセールスソフトウェア認定コース',
];
const salesforceCerts = [
  'Salesforce 認定 Platform アドミニストレーター',
  'Salesforce 認定 Platform アドミニストレーター 上級',
  'Salesforce 認定 Platform アプリケーションビルダー',
  'Salesforce 認定 Sales Cloud コンサルタント',
  'Salesforce 認定 Service Cloud コンサルタント',
];
---

<BaseLayout
  title="Hareka | HubSpot・CRM専門コンサルティング"
  description="HubSpot Japan出身・200社以上の支援経験を持つ代表が、HubSpotの導入から自走まで一貫して伴走。Salesforceからの移管、活用・定着支援まで対応します。"
  ogTitle="Hareka | 経営の視界を、クリアに。"
  ogDescription="HubSpot Japan出身・200社以上の支援経験。導入から自走まで、代表が一貫してご支援します。"
>

  <style>
    /* ===== 共通 ===== */
    .top-section {
      padding: 72px 0;
    }
    .eyebrow {
      display: block;
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 4px;
      text-transform: uppercase;
      color: var(--orange);
      margin-bottom: 14px;
    }
    .eyebrow--ja {
      letter-spacing: 0.05em;
      text-transform: none;
    }
    .top-heading {
      font-size: clamp(26px, 4vw, 34px);
      font-weight: 700;
      color: var(--text-head);
      line-height: 1.4;
      margin-bottom: 36px;
      letter-spacing: -0.01em;
    }

    /* ===== ヒーロー ===== */
    .top-hero {
      background: var(--bg-hero);
      padding: 148px 0 80px;
      border-bottom: 1px solid var(--border);
    }
    .top-hero__inner {
      max-width: 720px;
    }
    .top-hero__title {
      font-size: clamp(32px, 5vw, 48px);
      font-weight: 700;
      color: var(--text-head);
      line-height: 1.35;
      letter-spacing: -0.01em;
      margin-bottom: 24px;
    }
    .top-hero__lead {
      font-size: 16px;
      font-weight: 500;
      color: var(--text-body);
      line-height: 1.9;
      margin-bottom: 36px;
      max-width: 600px;
    }
    .top-hero__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
    }
    .top-hero__partner-badge {
      display: block;
      height: 64px;
      width: auto;
      margin-top: 40px;
    }
    .top-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 16px 32px;
      border-radius: 6px;
      font-size: 16px;
      font-weight: 700;
      line-height: 1;
      transition: background var(--transition), color var(--transition), border-color var(--transition);
    }
    .top-btn--primary {
      background: var(--orange);
      color: var(--white);
    }
    .top-btn--primary:hover {
      background: var(--orange-hover);
    }
    .top-btn--ghost {
      background: var(--white);
      color: var(--text-head);
      border: 1px solid var(--border-strong);
    }
    .top-btn--ghost:hover {
      border-color: var(--navy);
    }

    /* ===== 実績数値バー ===== */
    .stats-bar {
      padding: 56px 0;
      border-bottom: 1px solid var(--border);
    }
    .stats-bar__grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
    }
    .stats-bar__item {
      text-align: center;
      padding: 8px 24px;
      border-left: 1px solid var(--border-strong);
    }
    .stats-bar__item:first-child {
      border-left: none;
    }
    .stats-bar__icon {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 46px;
      color: var(--text-head);
      margin-bottom: 6px;
    }
    .stats-bar__num {
      display: block;
      font-size: 40px;
      font-weight: 700;
      color: var(--text-head);
      line-height: 1.2;
      letter-spacing: -0.02em;
      margin-bottom: 6px;
    }
    .stats-bar__label {
      display: block;
      font-size: 13px;
      font-weight: 500;
      color: var(--text-muted);
      line-height: 1.6;
    }

    /* ===== サービス ===== */
    .services-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
    .service-item {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 32px 30px;
    }
    .service-item__num {
      display: block;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 2px;
      color: var(--orange);
      margin-bottom: 14px;
    }
    .service-item__title {
      font-size: 18px;
      font-weight: 600;
      color: var(--text-head);
      line-height: 1.5;
      margin-bottom: 12px;
    }
    .service-item__text {
      font-size: 15px;
      font-weight: 400;
      color: var(--text-body);
      line-height: 1.9;
    }

    /* ===== 導入事例 ===== */
    .cases-section {
      background: var(--bg-soft);
    }
    .top-cases-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      margin-bottom: 40px;
    }
    .top-case-card {
      display: flex;
      flex-direction: column;
      gap: 14px;
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 28px;
      color: inherit;
      transition: border-color var(--transition);
    }
    .top-case-card:hover {
      border-color: var(--navy);
    }
    .top-case-card__tags {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }
    .top-case-card__tag {
      display: inline-block;
      padding: 3px 12px;
      background: var(--blue-light);
      color: var(--text-head);
      border-radius: 9999px;
      font-size: 12px;
      font-weight: 600;
    }
    .top-case-card__title {
      font-size: 17px;
      font-weight: 600;
      color: var(--text-head);
      line-height: 1.6;
      flex: 1;
    }
    .top-case-card__industry {
      font-size: 13px;
      font-weight: 500;
      color: var(--text-muted);
    }
    .cases-more {
      text-align: center;
    }
    .cases-more__link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 15px;
      font-weight: 600;
      color: var(--text-head);
      border-bottom: 1px solid var(--border-strong);
      padding-bottom: 3px;
      transition: color var(--transition), border-color var(--transition);
    }
    .cases-more__link:hover {
      color: var(--orange);
      border-color: var(--orange);
    }

    /* ===== 選ばれる理由 ===== */
    .why-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 40px;
    }
    .why-item {
      border-top: 2px solid var(--navy);
      padding-top: 20px;
    }
    .why-item__icon {
      display: block;
      color: var(--text-head);
      margin-bottom: 14px;
    }
    .why-item__title {
      font-size: 18px;
      font-weight: 600;
      color: var(--text-head);
      line-height: 1.5;
      margin-bottom: 12px;
    }
    .why-item__text {
      font-size: 15px;
      font-weight: 400;
      color: var(--text-body);
      line-height: 1.9;
    }

    /* ===== 代表プロフィール ===== */
    .founder-section {
      border-top: 1px solid var(--border);
    }
    .founder-main {
      display: flex;
      gap: 40px;
      align-items: flex-start;
      margin-bottom: 48px;
    }
    .founder-photo {
      width: 120px;
      height: 120px;
      border-radius: 50%;
      object-fit: cover;
      object-position: center top;
      flex-shrink: 0;
    }
    .founder-name {
      font-size: 24px;
      font-weight: 700;
      color: var(--text-head);
      margin-bottom: 4px;
    }
    .founder-role {
      font-size: 13px;
      font-weight: 500;
      color: var(--text-muted);
      margin-bottom: 18px;
    }
    .founder-bio {
      font-size: 16px;
      font-weight: 400;
      color: var(--text-body);
      line-height: 1.9;
      margin-bottom: 22px;
      max-width: 680px;
    }
    .founder-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .founder-pill {
      display: inline-block;
      padding: 5px 14px;
      background: var(--blue-light);
      color: var(--text-head);
      border-radius: 9999px;
      font-size: 12.5px;
      font-weight: 600;
    }
    .certs {
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 32px;
    }
    .certs__heading {
      font-size: 16px;
      font-weight: 600;
      color: var(--text-head);
      margin-bottom: 20px;
    }
    .certs__grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 28px;
    }
    .certs__group-title {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-muted);
      margin-bottom: 12px;
    }
    .certs__list li {
      font-size: 14.5px;
      font-weight: 400;
      color: var(--text-body);
      line-height: 1.7;
      padding: 5px 0 5px 16px;
      position: relative;
    }
    .certs__list li::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0.95em;
      width: 5px;
      height: 5px;
      background: var(--orange);
      border-radius: 50%;
    }
    /* ===== レスポンシブ ===== */
    @media (max-width: 960px) {
      .services-grid,
      .top-cases-grid,
      .why-grid {
        grid-template-columns: 1fr;
      }
      .why-grid {
        gap: 28px;
      }
      .certs__grid {
        grid-template-columns: 1fr;
      }
    }
    @media (max-width: 768px) {
      .top-section {
        padding: 56px 0;
      }
      .top-hero {
        padding: 120px 0 56px;
      }
      .stats-bar__grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 32px 0;
      }
      .stats-bar__item {
        border-left: none;
        padding: 8px 12px;
      }
      .stats-bar__item:nth-child(even) {
        border-left: 1px solid var(--border-strong);
      }
      .founder-main {
        flex-direction: column;
        align-items: center;
        text-align: center;
      }
      .founder-pills {
        justify-content: center;
      }
      .founder-bio {
        text-align: left;
      }
      .certs {
        padding: 24px 20px;
      }
    }
  </style>

  <!-- ヒーロー -->
  <section class="top-hero">
    <div class="container">
      <div class="top-hero__inner">
        <span class="eyebrow eyebrow--ja">HubSpot認定パートナー</span>
        <h1 class="top-hero__title">HubSpotの成果に、<br />プロフェッショナルの伴走を。</h1>
        <p class="top-hero__lead">HubSpot Japan出身・200社以上の支援経験を持つ代表が、導入から自走まで一貫してご支援します。担当変更も、引き継ぎもありません。</p>
        <div class="top-hero__actions">
          <a href="/contact" class="top-btn top-btn--primary">無料相談を予約する</a>
          <a href="/cases" class="top-btn top-btn--ghost">導入事例を見る</a>
        </div>
        <!-- 公式パートナーバッジ（画像は後日追加。未配置の間はonerrorで非表示） -->
        <img
          src="/images/hubspot-partner-badge.png"
          alt="HubSpot認定パートナー バッジ"
          class="top-hero__partner-badge"
          height="64"
          onerror="this.style.display='none'"
        />
      </div>
    </div>
  </section>

  <!-- 実績数値バー -->
  <section class="stats-bar">
    <div class="container">
      <div class="stats-bar__grid">
        <div class="stats-bar__item">
          <span class="stats-bar__icon" aria-hidden="true">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="8" r="7"/>
              <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/>
            </svg>
          </span>
          <span class="stats-bar__label">HubSpot認定パートナー</span>
        </div>
        <div class="stats-bar__item">
          <span class="stats-bar__num">200社+</span>
          <span class="stats-bar__label">支援実績</span>
        </div>
        <div class="stats-bar__item">
          <span class="stats-bar__num">8年+</span>
          <span class="stats-bar__label">CRM/SFA/MAの経験</span>
        </div>
        <div class="stats-bar__item">
          <span class="stats-bar__num">10資格</span>
          <span class="stats-bar__label">HubSpot・Salesforce認定</span>
        </div>
      </div>
    </div>
  </section>

  <!-- サービス -->
  <section class="top-section">
    <div class="container">
      <span class="eyebrow">Services</span>
      <h2 class="top-heading">支援メニュー</h2>
      <div class="services-grid">
        <div class="service-item">
          <span class="service-item__num">01</span>
          <h3 class="service-item__title">HubSpot導入支援</h3>
          <p class="service-item__text">初期設計から運用立ち上げまで。事業に合わせた設計で「使われるCRM」を作ります。</p>
        </div>
        <div class="service-item">
          <span class="service-item__num">02</span>
          <h3 class="service-item__title">Salesforce移管支援</h3>
          <p class="service-item__text">両ツールに精通。データと関連付けを正確に再現し、SaaSコストを削減します。</p>
        </div>
        <div class="service-item">
          <span class="service-item__num">03</span>
          <h3 class="service-item__title">活用・定着支援</h3>
          <p class="service-item__text">「導入したのに使われない」を解消。レポート整備と運用改善で成果につなげます。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 導入事例 -->
  <section class="top-section cases-section">
    <div class="container">
      <span class="eyebrow">Case Studies</span>
      <h2 class="top-heading">導入事例</h2>
      <div class="top-cases-grid">
        {featuredCases.map(c => (
          <a href={`/cases/${c.slug}/`} class="top-case-card">
            <div class="top-case-card__tags">
              {c.data.products.map((p: string) => (
                <span class="top-case-card__tag">{p}</span>
              ))}
            </div>
            <h3 class="top-case-card__title">{c.data.title}</h3>
            <p class="top-case-card__industry">{c.data.industry}</p>
          </a>
        ))}
      </div>
      <div class="cases-more">
        <a href="/cases" class="cases-more__link">すべての事例を見る →</a>
      </div>
    </div>
  </section>

  <!-- 選ばれる理由 -->
  <section class="top-section">
    <div class="container">
      <span class="eyebrow">Why Hareka</span>
      <h2 class="top-heading">Harekaが選ばれる理由</h2>
      <div class="why-grid">
        <div class="why-item">
          <span class="why-item__icon" aria-hidden="true">
            <!-- user-check -->
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="9" cy="7" r="4"/>
              <path d="M3 21v-2a4 4 0 0 1 4-4h4"/>
              <path d="M15 19l2 2l4-4"/>
            </svg>
          </span>
          <h3 class="why-item__title">代表が一貫して担当</h3>
          <p class="why-item__text">全案件を代表・岩間が最初から最後まで直接担当。担当者による当たり外れや引き継ぎロスの心配なく、安心してお任せいただけます。</p>
        </div>
        <div class="why-item">
          <span class="why-item__icon" aria-hidden="true">
            <!-- award -->
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="8" r="7"/>
              <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/>
            </svg>
          </span>
          <h3 class="why-item__title">200社以上の支援実績</h3>
          <p class="why-item__text">HubSpot Japan CSMとして約4年間で200社以上を支援。Marketing Hub、Sales Hub、Service Hub、Data Hubまで全製品に対応し、活用に苦しむ企業の利用状況を大きく改善してきました。独立後も多数の導入支援や移管支援を担当し、高い評価をいただいています。</p>
        </div>
        <div class="why-item">
          <span class="why-item__icon" aria-hidden="true">
            <!-- transfer -->
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 10h13l-4-4"/>
              <path d="M17 14H4l4 4"/>
            </svg>
          </span>
          <h3 class="why-item__title">Salesforce移管に強い</h3>
          <p class="why-item__text">Harekaが最も得意とする分野として、SalesforceからHubSpotへの移管は多数の実績があります。Salesforce認定資格を5つ保持し、ユーザーとしても3年以上利用。管理者と現場、両方の視点でSalesforceを深く理解しているからこそ、最適な移管設計ができます。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 代表プロフィール -->
  <section class="top-section founder-section">
    <div class="container">
      <span class="eyebrow">Founder</span>
      <h2 class="top-heading">代表プロフィール</h2>
      <div class="founder-main">
        <img src="/images/founder.jpg" alt="岩間 悠一" class="founder-photo" width="120" height="120" />
        <div class="founder-body">
          <p class="founder-name">岩間 悠一</p>
          <p class="founder-role">Hareka合同会社 代表 Yuichi Iwama</p>
          <p class="founder-bio">HubSpot JapanのカスタマーサクセスマネージャーとしてパナソニックやNTTなどの大企業からスタートアップまで200社以上を支援。前職のキーエンス・WeWorkでは営業の最前線を経験。ツールの設計と営業現場、両方を知るコンサルタントとして、CRMを「成果が出る仕組み」に変えることを専門としています。</p>
          <div class="founder-pills">
            <span class="founder-pill">HubSpot認定パートナー</span>
            <span class="founder-pill">HubSpot Japan出身</span>
            <span class="founder-pill">キーエンス</span>
            <span class="founder-pill">WeWork</span>
            <span class="founder-pill">英語対応可</span>
          </div>
        </div>
      </div>
      <div class="certs">
        <p class="certs__heading">保有資格</p>
        <div class="certs__grid">
          <div>
            <p class="certs__group-title">HubSpot認定（5つ）</p>
            <ul class="certs__list">
              {hubspotCerts.map(cert => <li>{cert}</li>)}
            </ul>
          </div>
          <div>
            <p class="certs__group-title">Salesforce認定（5つ）</p>
            <ul class="certs__list">
              {salesforceCerts.map(cert => <li>{cert}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-banner">
    <div class="container">
      <div class="cta-banner__inner">
        <div>
          <h2 class="cta-banner__title">まずは30分の無料相談から</h2>
          <p class="cta-banner__text">CRMの課題やお悩みを、お気軽にお聞かせください。</p>
        </div>
        <a href="/contact" class="btn btn--blue btn--lg">無料相談を予約する</a>
      </div>
    </div>
  </section>

</BaseLayout>
