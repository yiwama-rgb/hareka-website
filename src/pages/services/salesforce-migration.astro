---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Salesforce→HubSpot移行の事例（tool_beforeで判別）
const allCases = await getCollection('cases', ({ data }) => !data.draft);
const migrationCases = allCases
  .filter(c => c.data.tool_before.includes('Salesforce'))
  .sort((a, b) => a.slug.localeCompare(b.slug))
  .slice(0, 3);

const pageUrl = 'https://hareka.io/services/salesforce-migration/';
const pageDescription = 'Salesforce→HubSpot移行の専門支援。要件定義からデータ移行、定着まで代表が一貫担当。両CRMに精通したコンサルタントが、移行できないことも含めて正直にお伝えします。1時間の無料移行相談を実施中。';

const faqItems = [
  {
    q: 'Salesforceのデータはすべて移行できますか？',
    a: 'データそのものは、APIを活用したカスタムインポートでほぼすべて移行可能です。ただし、Salesforce特有の詳細な画面の作り込みや複雑なアクセス権限設定など、HubSpotの仕様上再現できない機能があります。再現できないものは要件定義の段階で正直にお伝えし、代替の設計をご提案します。',
  },
  {
    q: '移行にはどれくらいの期間がかかりますか？',
    a: '標準的な案件で2〜6ヶ月です。導入するHubの数、データ量と組織規模、レポートやワークフローなど既存アセットの量で変わります。急ぎすぎるとデータ移行の不具合リスクとお客様側の負担が大きくなるため、少し余裕を持った期間をおすすめしています。',
  },
  {
    q: '移行と同時に、新しい機能の追加や業務改善はできますか？',
    a: '可能ですが、順番があります。まず現在のSalesforceの仕組みをHubSpot上で確実に再現し、その基盤が整った後に、改善や新機能を段階的に実装します。最初から詰め込むと移行自体のリスクが上がるため、二段階で進めます。',
  },
  {
    q: '移行期間中、業務は止まりますか？',
    a: '通常業務は止まりません。本番稼働の直前に、週末などSalesforceの利用を一時停止できるタイミングで大型のデータ移行を行い、残りの差分は「デルタ移行」で反映します。業務への影響を最小化する設計で進めます。',
  },
  {
    q: '自社でやるべきことはありますか？',
    a: 'あります。特に要件定義では、業務ヒアリングへのご参加、現場での実際の使い方の共有、Salesforceおよび連携システムのアカウント情報のご提供をお願いしています。移行後に自走できる状態を作るためにも、要所での意思決定にはご参加いただきます。',
  },
  {
    q: '途中で要望が増えた場合はどうなりますか？',
    a: '技術的に可能でも、合意したスコープと期間を超える場合は、詰め込みによるトラブルを防ぐため、追加の開発期間をご相談させていただきます。スコープは要件定義書で事前に明確にするため、「言った・言わない」は発生しません。',
  },
];

// 構造化データ（Service）
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'SalesforceからHubSpotへの移行支援',
  serviceType: 'CRM移行支援・データ移行',
  description: pageDescription,
  url: pageUrl,
  areaServed: 'JP',
  provider: {
    '@type': 'Organization',
    name: 'Hareka合同会社',
    url: 'https://hareka.io',
  },
};

// 構造化データ（FAQPage）
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(item => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};

const phases = [
  {
    num: '01',
    title: '要件定義',
    body: [
      'お客様のSalesforce環境にアクセスし、データの棚卸しを行います。オブジェクトや項目の構成、レコード数と利用率、レポートやワークフローの状況、画面レイアウト、外部システムとの連携状況までを調査。同時に業務ヒアリングを実施し、「実際にどう使われているか」を明らかにします。',
      'その上で、利用率をもとに移行するデータと移行しないデータを仕分け、Salesforceのリードと取引先責任者をHubSpotのコンタクトへどう集約するかなどを設計。成果物として、開発スコープとスケジュールを明記した要件定義書（図解付き）を作成し、お互いの期待値を合わせます。HubSpotの仕様上再現できない機能がある場合は、この段階で正直にお伝えします。',
    ],
  },
  {
    num: '02',
    title: '構築・テスト移行',
    body: [
      'HubSpot側にプロパティと画面を構築し、フォームやメールなどのマーケティングアセットを作成します。その後、一部のデータのみを移行する「テスト移行」を実施し、要件定義書の通りにデータが取り込まれるか、Salesforceでの見え方が適切に再現されているかを確認します。',
    ],
  },
  {
    num: '03',
    title: '本移行',
    body: [
      'レポートの再現、ワークフローの構築、外部システムとのカスタム連携、マーケティングアセットの移行、データ本体の移行を進めます。SalesforceとHubSpotでは仕様の違いが多いため、時間のかかる要素（レポート・ワークフローが多い、連携が完全カスタム、データ量が膨大）は前倒しで着手します。',
    ],
  },
  {
    num: '04',
    title: 'カットオーバー準備',
    body: [
      '受け入れテスト（実際の業務の流れで問題なく使えるかをお客様自身に確認いただくテスト）を実施し、フィードバックを反映。並行して研修と簡易ドキュメント・動画マニュアルの整備を進めます。本番稼働直前には、週末などSalesforceの利用を一時停止できるタイミングで大型のデータ移行を行い、その後に発生した差分だけを移行する「デルタ移行」で、1件の漏れもない状態を作ってから本番稼働を迎えます。',
    ],
  },
];

const painPoints = [
  'Salesforceのライセンス費用とメンテナンス負荷が、事業規模に対して重くなってきた',
  '機能が自社の業務に対してオーバースペックだと感じ始めている',
  'Account Engagement（旧Pardot）とSales Cloudのデータベースが分かれており、部署間の連携がスムーズにいかない',
  'UIが使いづらく、現場がSalesforceを使わなくなってしまった',
  '移行したいが、データ移行で失敗しないか不安',
];

const features = [
  {
    title: '両方のCRMを知っているから、正直な設計ができる',
    body: ['代表はHubSpot Japanで約4年カスタマーサクセスマネージャーとして200社以上を支援し、Salesforce認定資格を5つ保有しています。SalesforceとHubSpotは仕様が大きく異なり、Salesforce特有の詳細な画面の作り込みや複雑なアクセス権限など、HubSpotでは再現できない機能もあります。Harekaでは「できること・できないこと」を要件定義の段階で率直にお伝えし、期待値を合わせた上でプロジェクトを進めます。'],
  },
  {
    title: 'AIを活用した、速く正確なデータ移行',
    body: ['移行の失敗で最も多いのはデータ移行です。ファイルインポートを繰り返す従来型の移行は、ミスが多く、修正工数が膨らみ続けます。HarekaはAPIを活用したカスタムインポートとAI技術により、迅速かつ正確なデータ移行を実現します。実績として、他社が提示した見積もり工数の約60%の期間で移行を完了したケースもあります。'],
  },
  {
    title: '代表が一貫して担当する体制',
    body: ['要件定義から移行完了、運用定着まで、すべて代表が直接担当します。担当者の交代や引き継ぎによる情報の欠落は発生しません。'],
  },
  {
    title: '「再現」で終わらせず、「自走」をゴールに',
    body: [
      'Harekaの土台には、キーエンス・WeWorkでの営業現場経験と、HubSpot Japanで200社以上の活用支援に携わった知見があります。だからこそ、「どういうCRMが現場で実際に使われ、どういうCRMが使われなくなるのか」を知っています。',
      '私たちのポリシーは、お客様が実際に使えて、成果の出るCRMを納品することです。移行はまず現在の仕組みをHubSpot上で確実に再現することから始め、基盤が整った後に改善を段階的に進めます。最終的には、お客様自身が設定変更や運用を自走できる状態がゴールです。実務で使える動画マニュアルの残し方や、HubSpot公式サポートの活用方法までレクチャーします。',
    ],
  },
];

// 数値実績ハイライト
const resultHighlights = [
  {
    num: ['60日', 'で', '50%削減'],
    text: 'ライセンス費用を50%削減しながら、60日で移行を完了。移行と同時に活用状況も改善しました。',
    href: '/cases/01-salesforce-hubspot-manufacturing/',
  },
  {
    num: ['70%削減'],
    text: 'AI活用のCRM再設計で入力工数を70%削減。現場から喜ばれる移行を実現しました。',
    href: '/cases/02-saas-salesforce-hubspot-datamigration/',
  },
  {
    num: ['30%削減'],
    text: '分散していたデータベースをHubSpotに統一し、部署間の連携を強化。同時にコストも30%削減しました。',
    href: '/cases/07-benefits-zendesk-hubspot-consolidation/',
  },
];

// よくある失敗（3つ）
const pitfalls = [
  {
    title: '失敗1: データ移行のミスが止まらない',
    body: [
      '移行の失敗で最も多いのがデータ移行です。ファイルインポートを何度も繰り返す方法で移行すると、ミスが多発し、その修正にさらに膨大な工数がかかります。この進め方をしている限り、ミスと修正コストは出続けます。API活用やAIによる移行ノウハウを持つパートナーかどうかの確認が、Salesforceに限らずあらゆるシステム移行で極めて重要です。',
    ],
  },
  {
    title: '失敗2: 要望通りに作った結果、「使われないCRM」になる',
    body: [
      '移行の成否は、実は要件定義の段階でほぼ決まります。お客様のご要望をそのまま受け入れて、複雑な自動化・レポート・オブジェクト構成を納品してしまうと、移行プロジェクト自体は成功しても、現場に理解されず、運用が形骸化し、成果につながらないCRMになります。',
      'お客様が言葉にする要望と、現場が本当に使いこなせる形は、異なることがあります。Harekaは200社以上の活用支援で「使われるCRM」と「使われないCRM」の違いを見てきました。だからこそ要件定義で妥協せずに対話し、本当に使えるCRMを納品します。AIを使える会社はこれからも増えますが、この活用支援の実績こそ、Harekaがどこにも負けない強みです。',
    ],
  },
  {
    title: '失敗3: 片方の製品しか知らない担当者に依頼してしまう',
    body: [
      'Salesforceを知らない担当者が移行を受けると、旧環境の設計意図を読み解けず、移行後に業務が回らなくなります。逆に、Salesforceには詳しくてもHubSpotを知らない担当者が受けると、HubSpotの仕様に合わない設計を持ち込んでしまいます。移行には両製品の深い知識が必要です。',
    ],
  },
];
---

<BaseLayout
  title="SalesforceからHubSpotへの移行支援・データ移行代行 | Hareka"
  description={pageDescription}
  ogUrl={pageUrl}
>
  <!-- 構造化データ (Service / FAQPage) -->
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <style>
    .sfm-section { padding: 72px 0; }
    .sfm-section--soft { background: var(--bg-soft); }
    .sfm-eyebrow {
      display: block;
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 4px;
      text-transform: uppercase;
      color: var(--orange);
      margin-bottom: 14px;
    }
    .sfm-heading {
      font-size: clamp(24px, 4vw, 32px);
      font-weight: 700;
      color: var(--text-head);
      line-height: 1.4;
      margin-bottom: 20px;
      letter-spacing: -0.01em;
    }
    .sfm-lead {
      font-size: 15px;
      color: var(--text-body);
      line-height: 1.9;
      max-width: 720px;
      margin-bottom: 36px;
    }

    /* ヒーロー */
    .sfm-hero {
      background: var(--bg-hero);
      padding: 148px 0 80px;
      border-bottom: 1px solid var(--border);
    }
    .sfm-hero__inner { max-width: 760px; }
    .sfm-hero__title {
      font-size: clamp(30px, 5vw, 44px);
      font-weight: 700;
      color: var(--text-head);
      line-height: 1.35;
      letter-spacing: -0.01em;
      margin-bottom: 24px;
    }
    .sfm-hero__lead {
      font-size: 16px;
      font-weight: 500;
      color: var(--text-body);
      line-height: 1.9;
      margin-bottom: 36px;
      max-width: 640px;
    }
    .sfm-hero__note {
      margin-top: 14px;
      font-size: 13px;
      color: var(--text-muted);
      line-height: 1.7;
    }

    /* 課題 */
    .sfm-pains {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 12px;
      max-width: 760px;
      margin-bottom: 28px;
    }
    .sfm-pains li {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      padding: 18px 24px;
      background: var(--white);
      border: 1px solid var(--border);
      border-left: 3px solid var(--orange);
      border-radius: var(--radius);
      font-size: 15px;
      color: var(--text-body);
      line-height: 1.75;
    }
    .sfm-pains__check {
      flex-shrink: 0;
      color: var(--orange);
      margin-top: 3px;
    }
    .sfm-pains-close {
      font-size: 15px;
      color: var(--text-body);
      line-height: 1.9;
      max-width: 760px;
    }

    /* 特徴 */
    .sfm-features {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }
    .sfm-feature {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 32px 30px;
    }
    .sfm-feature__num {
      display: block;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 2px;
      color: var(--orange);
      margin-bottom: 12px;
    }
    .sfm-feature__title {
      font-size: 18px;
      font-weight: 600;
      color: var(--text-head);
      line-height: 1.5;
      margin-bottom: 12px;
    }
    .sfm-feature__text {
      font-size: 14.5px;
      color: var(--text-body);
      line-height: 1.9;
    }
    .sfm-feature__text + .sfm-feature__text { margin-top: 12px; }

    /* 数値実績ハイライト */
    .sfm-results {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
    .sfm-result {
      display: flex;
      flex-direction: column;
      gap: 12px;
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 32px 30px;
      color: inherit;
      transition: border-color var(--transition);
    }
    .sfm-result:hover { border-color: var(--navy); }
    .sfm-result__num {
      font-size: 15px;
      font-weight: 700;
      color: var(--text-head);
      line-height: 1.3;
      letter-spacing: -0.01em;
    }
    .sfm-result__num em {
      font-style: normal;
      font-size: clamp(30px, 3.5vw, 38px);
      font-weight: 700;
      color: var(--orange);
    }
    .sfm-result__text {
      font-size: 14.5px;
      color: var(--text-body);
      line-height: 1.9;
      flex: 1;
    }
    .sfm-result__link {
      font-size: 14px;
      font-weight: 600;
      color: var(--text-head);
    }
    .sfm-result:hover .sfm-result__link { color: var(--orange); }

    /* フェーズ */
    .sfm-phases {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }
    .sfm-phase {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      overflow: hidden;
    }
    .sfm-phase__head {
      background: var(--navy);
      padding: 20px 30px;
      display: flex;
      align-items: center;
      gap: 18px;
    }
    .sfm-phase__num {
      flex-shrink: 0;
      width: 42px;
      height: 42px;
      background: rgba(255, 255, 255, 0.12);
      color: var(--white);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 15px;
      font-weight: 800;
    }
    .sfm-phase__title {
      font-size: 18px;
      font-weight: 700;
      color: var(--white);
    }
    .sfm-phase__body { padding: 26px 30px; }
    .sfm-phase__body p {
      font-size: 14.5px;
      color: var(--text-body);
      line-height: 1.9;
    }
    .sfm-phase__body p + p { margin-top: 14px; }

    /* 期間 */
    .sfm-period-table-wrap { overflow-x: auto; margin-bottom: 20px; }
    .sfm-period-table {
      width: 100%;
      min-width: 640px;
      border-collapse: collapse;
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      font-size: 14.5px;
      line-height: 1.7;
    }
    .sfm-period-table th,
    .sfm-period-table td {
      padding: 14px 20px;
      border: 1px solid var(--border);
      text-align: left;
      vertical-align: top;
    }
    .sfm-period-table thead th {
      background: var(--navy);
      color: var(--white);
      font-weight: 700;
      font-size: 14px;
    }
    .sfm-period-table tbody th {
      background: var(--bg-soft);
      color: var(--text-head);
      font-weight: 600;
      white-space: nowrap;
    }
    .sfm-period-note {
      font-size: 14px;
      color: var(--text-muted);
      line-height: 1.8;
      max-width: 760px;
    }

    /* よくある失敗 */
    .sfm-failures {
      display: flex;
      flex-direction: column;
      gap: 20px;
      max-width: 820px;
    }
    .sfm-failure {
      background: var(--white);
      border: 1px solid var(--border);
      border-left: 4px solid var(--orange);
      border-radius: var(--radius);
      padding: 28px 32px;
    }
    .sfm-failure__title {
      font-size: 18px;
      font-weight: 700;
      color: var(--text-head);
      line-height: 1.5;
      margin-bottom: 12px;
    }
    .sfm-failure__text {
      font-size: 15px;
      color: var(--text-body);
      line-height: 1.9;
    }
    .sfm-failure__text + .sfm-failure__text { margin-top: 12px; }

    /* FAQ */
    .sfm-faq {
      display: flex;
      flex-direction: column;
      gap: 16px;
      max-width: 820px;
    }
    .sfm-faq__item {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 24px 28px;
    }
    .sfm-faq__q {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      font-size: 16px;
      font-weight: 600;
      color: var(--text-head);
      line-height: 1.6;
      margin-bottom: 12px;
    }
    .sfm-faq__q::before {
      content: 'Q';
      flex-shrink: 0;
      width: 26px;
      height: 26px;
      background: var(--navy);
      color: var(--white);
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      font-weight: 700;
      margin-top: 1px;
    }
    .sfm-faq__a {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      font-size: 14.5px;
      color: var(--text-body);
      line-height: 1.9;
    }
    .sfm-faq__a::before {
      content: 'A';
      flex-shrink: 0;
      width: 26px;
      height: 26px;
      background: var(--orange);
      color: var(--white);
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      font-weight: 700;
      margin-top: 3px;
    }

    /* 実績 */
    .sfm-cases-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      margin-bottom: 40px;
    }
    .sfm-case-card {
      display: flex;
      flex-direction: column;
      gap: 14px;
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 28px;
      color: inherit;
      transition: border-color var(--transition);
    }
    .sfm-case-card:hover { border-color: var(--navy); }
    .sfm-case-card__tags {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }
    .sfm-case-card__tag {
      display: inline-block;
      padding: 3px 12px;
      background: var(--blue-light);
      color: var(--text-head);
      border-radius: 9999px;
      font-size: 12px;
      font-weight: 600;
    }
    .sfm-case-card__title {
      font-size: 17px;
      font-weight: 600;
      color: var(--text-head);
      line-height: 1.6;
      flex: 1;
    }
    .sfm-case-card__industry {
      font-size: 13px;
      font-weight: 500;
      color: var(--text-muted);
    }
    .sfm-cases-more { text-align: center; }
    .sfm-cases-more__link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 15px;
      font-weight: 600;
      color: var(--text-head);
      border-bottom: 1px solid var(--border-strong);
      padding-bottom: 3px;
      transition: color var(--transition), border-color var(--transition);
    }
    .sfm-cases-more__link:hover {
      color: var(--orange);
      border-color: var(--orange);
    }

    /* 最終CTA */
    .sfm-final-cta {
      background: var(--dark);
      padding: 88px 0;
    }
    .sfm-final-cta__inner { max-width: 760px; }
    .sfm-final-cta__title {
      font-size: clamp(26px, 3.5vw, 32px);
      font-weight: 700;
      color: var(--white);
      line-height: 1.4;
      margin-bottom: 18px;
    }
    .sfm-final-cta__text {
      font-size: 15px;
      color: rgba(255, 255, 255, 0.78);
      line-height: 1.9;
      margin-bottom: 28px;
    }
    .sfm-final-cta__subtitle {
      font-size: 14px;
      font-weight: 700;
      color: var(--white);
      margin-bottom: 12px;
    }
    .sfm-final-cta__list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-bottom: 32px;
    }
    .sfm-final-cta__list li {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      font-size: 14.5px;
      color: rgba(255, 255, 255, 0.78);
      line-height: 1.7;
    }
    .sfm-final-cta__list li::before {
      content: '';
      flex-shrink: 0;
      width: 6px;
      height: 6px;
      background: var(--orange);
      border-radius: 50%;
      margin-top: 9px;
    }

    @media (max-width: 960px) {
      .sfm-features,
      .sfm-results,
      .sfm-cases-grid {
        grid-template-columns: 1fr;
      }
    }
    @media (max-width: 768px) {
      .sfm-section { padding: 56px 0; }
      .sfm-hero { padding: 120px 0 56px; }
      .sfm-phase__head { padding: 18px 22px; }
      .sfm-phase__body { padding: 22px; }
      .sfm-failure { padding: 24px; }
      .sfm-faq__item { padding: 20px; }
      .sfm-final-cta { padding: 64px 0; }
    }
  </style>

  <!-- 1. ヒーロー -->
  <section class="sfm-hero">
    <div class="container">
      <div class="sfm-hero__inner">
        <span class="sfm-eyebrow">Salesforce → HubSpot</span>
        <h1 class="sfm-hero__title">SalesforceからHubSpotへの移行支援</h1>
        <p class="sfm-hero__lead">SalesforceとHubSpot、両方の現場を知るコンサルタントが、要件定義からデータ移行、運用定着まで一貫して支援します。移行できないことも、契約前に正直にお伝えします。</p>
        <a href="/contact/" class="btn btn--primary btn--lg">1時間の無料移行相談を予約する</a>
        <p class="sfm-hero__note">現状を伺い、移行の可否・概算工数・進め方の見立てをその場でお返しします。</p>
      </div>
    </div>
  </section>

  <!-- 2. 課題（共感） -->
  <section class="sfm-section sfm-section--soft">
    <div class="container">
      <span class="sfm-eyebrow">Challenges</span>
      <h2 class="sfm-heading">こんな課題はありませんか</h2>
      <ul class="sfm-pains">
        {painPoints.map(point => (
          <li>
            <span class="sfm-pains__check" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </span>
            {point}
          </li>
        ))}
      </ul>
      <p class="sfm-pains-close">これらは、実際にHarekaにご相談いただいた企業に共通していた課題です。1つでも当てはまるなら、移行を検討するタイミングかもしれません。</p>
    </div>
  </section>

  <!-- 実績ハイライト -->
  <section class="sfm-section">
    <div class="container">
      <span class="sfm-eyebrow">Results</span>
      <h2 class="sfm-heading">数字で見る、Harekaの移行支援</h2>
      <div class="sfm-results">
        {resultHighlights.map(r => (
          <a href={r.href} class="sfm-result">
            <p class="sfm-result__num">
              {r.num.map(part => (part.match(/^(で)$/) ? part : <em>{part}</em>))}
            </p>
            <p class="sfm-result__text">{r.text}</p>
            <span class="sfm-result__link">事例を見る →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. 特徴 -->
  <section class="sfm-section sfm-section--soft">
    <div class="container">
      <span class="sfm-eyebrow">Features</span>
      <h2 class="sfm-heading">Harekaの移行支援の特徴</h2>
      <div class="sfm-features">
        {features.map((f, i) => (
          <div class="sfm-feature">
            <span class="sfm-feature__num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="sfm-feature__title">{f.title}</h3>
            {f.body.map(p => <p class="sfm-feature__text">{p}</p>)}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. 進め方 -->
  <section class="sfm-section">
    <div class="container">
      <span class="sfm-eyebrow">Process</span>
      <h2 class="sfm-heading">移行の進め方（4フェーズ）</h2>
      <div class="sfm-phases">
        {phases.map(phase => (
          <div class="sfm-phase">
            <div class="sfm-phase__head">
              <div class="sfm-phase__num">{phase.num}</div>
              <h3 class="sfm-phase__title">フェーズ{Number(phase.num)}: {phase.title}</h3>
            </div>
            <div class="sfm-phase__body">
              {phase.body.map(p => <p>{p}</p>)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. 期間の目安 -->
  <section class="sfm-section sfm-section--soft">
    <div class="container">
      <span class="sfm-eyebrow">Timeline</span>
      <h2 class="sfm-heading">期間の目安</h2>
      <p class="sfm-lead">標準的な案件で2〜6ヶ月です。期間は主に次の3つで決まります。</p>
      <div class="sfm-period-table-wrap">
        <table class="sfm-period-table">
          <thead>
            <tr>
              <th>要素</th>
              <th>短くなるケース</th>
              <th>長くなるケース</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th>業務範囲・導入Hub数</th>
              <td>Sales Hubのみ</td>
              <td>Marketing Hub・Service Hubも含む</td>
            </tr>
            <tr>
              <th>データ量・組織規模</th>
              <td>従業員10〜20名規模</td>
              <td>100名前後の規模</td>
            </tr>
            <tr>
              <th>既存アセット</th>
              <td>ワークフローがなく、レポートも5〜10本程度（2ヶ月程度で完了できる規模）</td>
              <td>本数が多い・複雑・カスタムオブジェクト多数</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="sfm-period-note">急いだ移行はデータ移行の不具合リスクとお客様側の負担を高めるため、少し長めの期間を見込むことをおすすめしています。正確な期間は、無料相談または要件定義でお見立てします。</p>
    </div>
  </section>

  <!-- 6. よくある失敗 -->
  <section class="sfm-section">
    <div class="container">
      <span class="sfm-eyebrow">Common Pitfalls</span>
      <h2 class="sfm-heading">Salesforce→HubSpot移行で起こりがちな3つの失敗</h2>
      <div class="sfm-failures">
        {pitfalls.map(item => (
          <div class="sfm-failure">
            <h3 class="sfm-failure__title">{item.title}</h3>
            {item.body.map(p => <p class="sfm-failure__text">{p}</p>)}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. FAQ -->
  <section class="sfm-section sfm-section--soft">
    <div class="container">
      <span class="sfm-eyebrow">FAQ</span>
      <h2 class="sfm-heading">よくあるご質問</h2>
      <div class="sfm-faq">
        {faqItems.map(item => (
          <div class="sfm-faq__item">
            <h3 class="sfm-faq__q">{item.q}</h3>
            <p class="sfm-faq__a">{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. 実績 -->
  <section class="sfm-section">
    <div class="container">
      <span class="sfm-eyebrow">Case Studies</span>
      <h2 class="sfm-heading">移行支援の実績</h2>
      <p class="sfm-lead">製造業からSaaS企業まで、規模も業種も異なる移行を支援してきました。すべて代表が一貫して担当した案件です。</p>
      <div class="sfm-cases-grid">
        {migrationCases.map(c => (
          <a href={`/cases/${c.slug}/`} class="sfm-case-card">
            <div class="sfm-case-card__tags">
              {(c.data.products ?? []).map((p: string) => (
                <span class="sfm-case-card__tag">{p}</span>
              ))}
            </div>
            <h3 class="sfm-case-card__title">{c.data.title}</h3>
            <p class="sfm-case-card__industry">{c.data.industry}</p>
          </a>
        ))}
      </div>
      <div class="sfm-cases-more">
        <a href="/cases/" class="sfm-cases-more__link">すべての事例を見る →</a>
      </div>
    </div>
  </section>

  <!-- 9. 最終CTA -->
  <section class="sfm-final-cta">
    <div class="container">
      <div class="sfm-final-cta__inner">
        <h2 class="sfm-final-cta__title">まずは1時間の無料移行相談から</h2>
        <p class="sfm-final-cta__text">移行すべきかどうか迷っている段階でも構いません。1時間の相談で、現状の課題を伺った上で、移行の可否・概算の工数感・進め方の見立てをその場でお返しします。無理な売り込みは行いません。「今は移行しないほうがいい」というご提案をすることもあります。</p>
        <p class="sfm-final-cta__subtitle">相談で持ち帰っていただけるもの</p>
        <ul class="sfm-final-cta__list">
          <li>現在のSalesforce環境が移行に向くかどうかの見立て</li>
          <li>移行する場合のおおまかな工数感と期間</li>
          <li>進め方のステップと、社内で準備しておくべきこと</li>
        </ul>
        <a href="/contact/" class="btn btn--primary btn--lg">無料移行相談を予約する</a>
      </div>
    </div>
  </section>
</BaseLayout>
