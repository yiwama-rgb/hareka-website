---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// 活用支援・再活用の事例
const allCases = await getCollection('cases', ({ data }) => !data.draft);
const reactivationCases = allCases
  .filter(c => (c.data.supportType ?? []).includes('活用支援'))
  .sort((a, b) => a.slug.localeCompare(b.slug))
  .slice(0, 3);

const pageUrl = 'https://hareka.io/services/hubspot-reactivation/';
const pageDescription = '「契約したのに使われていない」HubSpotを立て直す再活用支援。200社以上を支援した元HubSpot CSMが、使われない原因を組織から分析し、実装から定着まで伴走。活用スコア7倍・商談数20%増の実績。1時間の無料相談を実施中。';

const faqItems = [
  {
    q: '費用対効果（ROI）はどう考えればいいですか？',
    a: '契約前の段階で「どのような効果を目指すか」を一緒に設計します。パターンは主に2つあり、1つは商談数や商談化率など売上に近いKPIの向上、もう1つは業務工数の削減です。CRM導入で業務工数を50〜70%削減できた事例は非常に多く、工数削減によるROI算出は現実的で効果的です。',
  },
  {
    q: 'どれくらいで成果が出ますか？',
    a: '効果が見え始めるまで少なくとも3ヶ月以上、一般的には半年から1年ほどを見ていただいています。組織に定着させる支援である以上、短期の魔法はありませんが、正しい手順で積み上げれば確実に変わります。',
  },
  {
    q: '社内の担当者に任せるのと何が違うのですか？',
    a: '現在のCRM活用には、CRM単体の知識だけでなく、AIを含む周辺ツールを活用した業務改善——SalesOpsやRevOpsと呼ばれる領域——の知識が求められます。この人材を社内で育成するには膨大な時間がかかり、体系的に学べる環境も国内にはほとんどありません。採用市場にもこのスキルを持つ人材はほぼおらず、採用コストとミスマッチのリスクが大きいのが実情です。外部活用は、この育成・採用リスクを抑えながら専門知識を使う現実的な選択肢です。',
  },
  {
    q: '支援が終わった後、また使われなくなりませんか？',
    a: 'そうならない仕組みを設計します。ポイントは、ルールで縛ることではなく「HubSpotにデータを入れたくなる状態」を作ることです。HubSpotはデータを集める箱として最適なツールです。だからこそ、入力すれば業務が楽になり、入力しないと非効率になる——そういう業務フローを社内に組み込みます。あわせて、社内の推進担当者と一緒にプロジェクトを進めることで運用ノウハウを社内に残します。支援終了後も、外部に頼らず仕組みが回り続ける状態がゴールです。',
  },
  {
    q: 'まだ社内の合意が取れていない段階でも相談できますか？',
    a: 'できます。経営層への説明材料づくりや、KPI・費用対効果の設計からご一緒するケースも多くあります。無料相談では、現状を伺った上で「社内をどう動かすか」の進め方もお伝えします。',
  },
];

// 構造化データ（Service）
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'HubSpot再活用・定着支援',
  serviceType: 'CRM活用支援・定着支援',
  description: pageDescription,
  url: pageUrl,
  areaServed: 'JP',
  provider: {
    '@type': 'Organization',
    name: 'Hareka合同会社',
    url: 'https://hareka.io',
  },
};

// 構造化データ（FAQPage）
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(item => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};

const painPoints = [
  'HubSpotを契約したが、ログインする人がほとんどいない',
  '導入を推進していた担当者が異動・退職し、そのまま放置されている',
  '商談管理は結局Excelに戻ってしまい、HubSpotは名刺データベースになっている',
  '経営会議のレポートはHubSpotの外で作られている',
  '毎月のライセンス費用が、成果の見えないコストになっている',
];

const resultHighlights = [
  {
    num: '約7倍',
    text: 'ほぼ未活用の状態から約1年の伴走で、HubSpotの活用スコアを支援開始前の約7倍に改善しました。',
    href: '/cases/03-consulting-hubspot-reactivation/',
  },
  {
    num: '商談数 20%増',
    text: 'チームごとのExcel案件管理をHubSpotに一元化。全体が見える化され、適切な施策を打てるようになった結果、商談数が約20%増加しました。',
    href: '/cases/06-investment-fund-hubspot-launch/',
  },
  {
    num: 'メール配信工数 50%削減',
    text: '個別ツールやBCCでの一斉送信をHubSpotのマーケティングメールに統合し、配信工数を半減させました。',
    href: '/cases/03-consulting-hubspot-reactivation/',
  },
];

const causes = [
  {
    title: '経営層を巻き込めていない',
    body: '経営層が悪いのではなく、経営層の声を活用推進に使えていない状態です。トップの意思決定と一定の強制力がないまま、現場の善意だけでCRM活用は定着しません。',
  },
  {
    title: '推進担当者（旗振り役）の不在',
    body: '経営層のドライブがあっても、現場でプロジェクトを推進する担当者がいなければ止まります。担当者の異動・退職でそのまま放置されるケースが非常に多くあります。',
  },
  {
    title: 'KPI・ゴールが曖昧',
    body: '「活用して何になるのか」に答えがないと、現場は入力する意味を見失います。「この数値を上げるために使う」という明確なKPIの設定が必要です。',
  },
  {
    title: '現場のサポート体制がない',
    body: '操作や運用で困ったときに、すぐ聞ける場所がない。社内の問い合わせ窓口や、HubSpot公式サポートの活用方法の周知が必要です。',
  },
  {
    title: '使わなくても業務が回ってしまう',
    body: '商談管理も最終レポートも従来通りExcelで完結できてしまう環境では、HubSpotは使われません。「HubSpotを使わなければ業務が回らない仕組み」への移行——例えばレポーティングをHubSpot内で完結させること——が定着の鍵です。',
  },
];

const features = [
  {
    title: 'HubSpotのデータと、HubSpot社との連携で現状を可視化する',
    body: 'お客様のHubSpot環境の利用データを直接分析するのに加え、HubSpotのCSM担当とも連携し、HubSpot側で確認できる詳細データも参考にします。元HubSpot CSMだからこそ、この連携をスムーズに進められます。感覚ではなくデータで「どこが使われていないか」を特定します。',
  },
  {
    title: '組織から動かす',
    body: '活用の失敗は組織の問題であることが多いため、機能の構築より先に、経営層の支持の取り付けと社内の連携体制づくりからアプローチします。ツールをいじる前に、ツールが使われる土壌を作ります。',
  },
  {
    title: '「使えるようになった」で終わらせない',
    body: '実装した機能を現場で使ってもらい、フィードバックを受けて改善するサイクルを回します。そして最初に設定したKPIにプラスの影響が出ているかを定期的にチェックし、成果が出るまで活用を推進します。',
  },
  {
    title: '代表が一貫して担当',
    body: '現状分析から実装、定着まで、すべて代表が直接担当します。CRM活用にはAIや周辺ツールを含む幅広い知識が求められますが、その領域を専門とするコンサルタントが最初から最後まで伴走します。',
  },
];

const steps = [
  {
    num: '01',
    title: '現状分析・原因特定',
    body: 'HubSpot環境にアクセスし、どの機能がどれくらい使われているか（使われていないか）をデータで確認します。並行して業務・組織体制・KPIを詳細にヒアリングし、活用の余地と「なぜ今できていないのか」の原因を特定します。',
  },
  {
    num: '02',
    title: '改善設計・合意形成',
    body: '取り組むべきタスク、優先順位、スケジュール、必要なリソースを整理し、お客様と合意形成します。何を目指してどの順番で進めるかを、着手前に明確にします。',
  },
  {
    num: '03',
    title: '社内体制づくりと実装',
    body: 'まず経営層の支持の取り付けと社内の連携体制を整えます。その上で、不足しているレポートの作成、プロパティの追加、レコード詳細画面の整備など、欠けている機能を構築します。',
  },
  {
    num: '04',
    title: '定着サイクルとKPIチェック',
    body: '実装した機能を現場で使ってもらい、フィードバックを反映する改善サイクルを回します。あわせて、最初に設定したKPIへの影響を定期的にチェックし、成果につながるまで推進を続けます。',
  },
];
---

<BaseLayout
  title="HubSpot再活用・定着支援｜「使われていない」を立て直す | Hareka"
  description={pageDescription}
  ogUrl={pageUrl}
>
  <!-- 構造化データ (Service / FAQPage) -->
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <style>
    .hsr-section { padding: 72px 0; }
    .hsr-section--soft { background: var(--bg-soft); }
    .hsr-eyebrow {
      display: block;
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 4px;
      text-transform: uppercase;
      color: var(--orange);
      margin-bottom: 14px;
    }
    .hsr-eyebrow--ja {
      letter-spacing: 0.05em;
      text-transform: none;
    }
    .hsr-heading {
      font-size: clamp(24px, 4vw, 32px);
      font-weight: 700;
      color: var(--text-head);
      line-height: 1.4;
      margin-bottom: 20px;
      letter-spacing: -0.01em;
    }
    .hsr-lead {
      font-size: 15px;
      color: var(--text-body);
      line-height: 1.9;
      max-width: 760px;
      margin-bottom: 36px;
    }

    /* ヒーロー */
    .hsr-hero {
      background: var(--bg-hero);
      padding: 148px 0 80px;
      border-bottom: 1px solid var(--border);
    }
    .hsr-hero__inner { max-width: 760px; }
    .hsr-hero__title {
      font-size: clamp(28px, 4.6vw, 42px);
      font-weight: 700;
      color: var(--text-head);
      line-height: 1.4;
      letter-spacing: -0.01em;
      margin-bottom: 24px;
    }
    .hsr-hero__lead {
      font-size: 16px;
      font-weight: 500;
      color: var(--text-body);
      line-height: 1.9;
      margin-bottom: 36px;
      max-width: 660px;
    }
    .hsr-hero__note {
      margin-top: 14px;
      font-size: 13px;
      color: var(--text-muted);
      line-height: 1.7;
    }

    /* 共感 */
    .hsr-pains {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 12px;
      max-width: 760px;
      margin-bottom: 28px;
    }
    .hsr-pains li {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      padding: 18px 24px;
      background: var(--white);
      border: 1px solid var(--border);
      border-left: 3px solid var(--orange);
      border-radius: var(--radius);
      font-size: 15px;
      color: var(--text-body);
      line-height: 1.75;
    }
    .hsr-pains__check {
      flex-shrink: 0;
      color: var(--orange);
      margin-top: 3px;
    }
    .hsr-pains-close {
      font-size: 15px;
      color: var(--text-body);
      line-height: 1.9;
      max-width: 760px;
    }

    /* 実績ハイライト */
    .hsr-results {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
    .hsr-result {
      display: flex;
      flex-direction: column;
      gap: 12px;
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 32px 30px;
      color: inherit;
      transition: border-color var(--transition);
    }
    a.hsr-result:hover { border-color: var(--navy); }
    .hsr-result__num {
      font-size: clamp(26px, 3vw, 34px);
      font-weight: 700;
      color: var(--orange);
      line-height: 1.3;
      letter-spacing: -0.01em;
    }
    .hsr-result__text {
      font-size: 14.5px;
      color: var(--text-body);
      line-height: 1.9;
      flex: 1;
    }
    .hsr-result__link {
      font-size: 14px;
      font-weight: 600;
      color: var(--text-head);
    }
    a.hsr-result:hover .hsr-result__link { color: var(--orange); }

    /* 原因 */
    .hsr-causes {
      display: flex;
      flex-direction: column;
      gap: 16px;
      max-width: 820px;
    }
    .hsr-cause {
      display: flex;
      align-items: flex-start;
      gap: 18px;
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 24px 28px;
    }
    .hsr-cause__num {
      flex-shrink: 0;
      width: 38px;
      height: 38px;
      background: var(--navy);
      color: var(--white);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      font-weight: 800;
      margin-top: 2px;
    }
    .hsr-cause__title {
      font-size: 16.5px;
      font-weight: 700;
      color: var(--text-head);
      line-height: 1.5;
      margin-bottom: 8px;
    }
    .hsr-cause__text {
      font-size: 14.5px;
      color: var(--text-body);
      line-height: 1.9;
    }

    /* 特徴 */
    .hsr-features {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }
    .hsr-feature {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 32px 30px;
    }
    .hsr-feature__num {
      display: block;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 2px;
      color: var(--orange);
      margin-bottom: 12px;
    }
    .hsr-feature__title {
      font-size: 18px;
      font-weight: 600;
      color: var(--text-head);
      line-height: 1.5;
      margin-bottom: 12px;
    }
    .hsr-feature__text {
      font-size: 14.5px;
      color: var(--text-body);
      line-height: 1.9;
    }

    /* 進め方 */
    .hsr-steps {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }
    .hsr-step {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      overflow: hidden;
    }
    .hsr-step__head {
      background: var(--navy);
      padding: 20px 30px;
      display: flex;
      align-items: center;
      gap: 18px;
    }
    .hsr-step__num {
      flex-shrink: 0;
      width: 42px;
      height: 42px;
      background: rgba(255, 255, 255, 0.12);
      color: var(--white);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 15px;
      font-weight: 800;
    }
    .hsr-step__title {
      font-size: 18px;
      font-weight: 700;
      color: var(--white);
    }
    .hsr-step__body { padding: 26px 30px; }
    .hsr-step__body p {
      font-size: 14.5px;
      color: var(--text-body);
      line-height: 1.9;
    }

    /* 期間 */
    .hsr-period {
      max-width: 760px;
    }
    .hsr-period p {
      font-size: 15px;
      color: var(--text-body);
      line-height: 1.95;
    }
    .hsr-period p + p { margin-top: 16px; }

    /* 前提条件 */
    .hsr-conditions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      max-width: 820px;
      margin-bottom: 28px;
    }
    .hsr-condition {
      background: var(--white);
      border: 1px solid var(--border);
      border-left: 4px solid var(--orange);
      border-radius: var(--radius);
      padding: 28px 30px;
    }
    .hsr-condition__title {
      font-size: 17px;
      font-weight: 700;
      color: var(--text-head);
      line-height: 1.5;
      margin-bottom: 10px;
    }
    .hsr-condition__text {
      font-size: 14.5px;
      color: var(--text-body);
      line-height: 1.9;
    }
    .hsr-conditions-close {
      font-size: 15px;
      color: var(--text-body);
      line-height: 1.9;
      max-width: 820px;
    }

    /* FAQ */
    .hsr-faq {
      display: flex;
      flex-direction: column;
      gap: 16px;
      max-width: 820px;
    }
    .hsr-faq__item {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 24px 28px;
    }
    .hsr-faq__q {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      font-size: 16px;
      font-weight: 600;
      color: var(--text-head);
      line-height: 1.6;
      margin-bottom: 12px;
    }
    .hsr-faq__q::before {
      content: 'Q';
      flex-shrink: 0;
      width: 26px;
      height: 26px;
      background: var(--navy);
      color: var(--white);
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      font-weight: 700;
      margin-top: 1px;
    }
    .hsr-faq__a {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      font-size: 14.5px;
      color: var(--text-body);
      line-height: 1.9;
    }
    .hsr-faq__a::before {
      content: 'A';
      flex-shrink: 0;
      width: 26px;
      height: 26px;
      background: var(--orange);
      color: var(--white);
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      font-weight: 700;
      margin-top: 3px;
    }

    /* 事例 */
    .hsr-cases-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      margin-bottom: 40px;
    }
    .hsr-case-card {
      display: flex;
      flex-direction: column;
      gap: 14px;
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 28px;
      color: inherit;
      transition: border-color var(--transition);
    }
    .hsr-case-card:hover { border-color: var(--navy); }
    .hsr-case-card__tags {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }
    .hsr-case-card__tag {
      display: inline-block;
      padding: 3px 12px;
      background: var(--blue-light);
      color: var(--text-head);
      border-radius: 9999px;
      font-size: 12px;
      font-weight: 600;
    }
    .hsr-case-card__title {
      font-size: 17px;
      font-weight: 600;
      color: var(--text-head);
      line-height: 1.6;
      flex: 1;
    }
    .hsr-case-card__industry {
      font-size: 13px;
      font-weight: 500;
      color: var(--text-muted);
    }
    .hsr-cases-more { text-align: center; }
    .hsr-cases-more__link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 15px;
      font-weight: 600;
      color: var(--text-head);
      border-bottom: 1px solid var(--border-strong);
      padding-bottom: 3px;
      transition: color var(--transition), border-color var(--transition);
    }
    .hsr-cases-more__link:hover {
      color: var(--orange);
      border-color: var(--orange);
    }

    /* 最終CTA */
    .hsr-final-cta {
      background: var(--dark);
      padding: 88px 0;
    }
    .hsr-final-cta__inner { max-width: 760px; }
    .hsr-final-cta__title {
      font-size: clamp(26px, 3.5vw, 32px);
      font-weight: 700;
      color: var(--white);
      line-height: 1.4;
      margin-bottom: 18px;
    }
    .hsr-final-cta__text {
      font-size: 15px;
      color: rgba(255, 255, 255, 0.78);
      line-height: 1.9;
      margin-bottom: 28px;
    }
    .hsr-final-cta__subtitle {
      font-size: 14px;
      font-weight: 700;
      color: var(--white);
      margin-bottom: 12px;
    }
    .hsr-final-cta__list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-bottom: 32px;
    }
    .hsr-final-cta__list li {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      font-size: 14.5px;
      color: rgba(255, 255, 255, 0.78);
      line-height: 1.7;
    }
    .hsr-final-cta__list li::before {
      content: '';
      flex-shrink: 0;
      width: 6px;
      height: 6px;
      background: var(--orange);
      border-radius: 50%;
      margin-top: 9px;
    }

    @media (max-width: 960px) {
      .hsr-features,
      .hsr-results,
      .hsr-conditions,
      .hsr-cases-grid {
        grid-template-columns: 1fr;
      }
    }
    @media (max-width: 768px) {
      .hsr-section { padding: 56px 0; }
      .hsr-hero { padding: 120px 0 56px; }
      .hsr-step__head { padding: 18px 22px; }
      .hsr-step__body { padding: 22px; }
      .hsr-cause { padding: 20px; }
      .hsr-condition { padding: 22px; }
      .hsr-faq__item { padding: 20px; }
      .hsr-final-cta { padding: 64px 0; }
    }
  </style>

  <!-- 1. ヒーロー -->
  <section class="hsr-hero">
    <div class="container">
      <div class="hsr-hero__inner">
        <span class="hsr-eyebrow hsr-eyebrow--ja">HubSpot 再活用・定着支援</span>
        <h1 class="hsr-hero__title">「使われていないHubSpot」を、成果の出る仕組みに立て直す</h1>
        <p class="hsr-hero__lead">200社以上の活用支援に携わった元HubSpot CSMが、使われない原因を組織とデータの両面から特定し、実装から定着、成果まで伴走します。</p>
        <a href="/contact/" class="btn btn--primary btn--lg">1時間の無料相談で現状を診断する</a>
        <p class="hsr-hero__note">利用状況を伺った上で、活用の余地と立て直しの進め方の見立てをその場でお返しします。</p>
      </div>
    </div>
  </section>

  <!-- 2. 共感 -->
  <section class="hsr-section hsr-section--soft">
    <div class="container">
      <span class="hsr-eyebrow">Challenges</span>
      <h2 class="hsr-heading">こんな状態ではありませんか</h2>
      <ul class="hsr-pains">
        {painPoints.map(point => (
          <li>
            <span class="hsr-pains__check" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </span>
            {point}
          </li>
        ))}
      </ul>
      <p class="hsr-pains-close">どれも、実際にHarekaへご相談いただいた企業に共通していた状態です。そしてこの状態は、正しい手順を踏めば立て直せます。</p>
    </div>
  </section>

  <!-- 3. 実績ハイライト -->
  <section class="hsr-section">
    <div class="container">
      <span class="hsr-eyebrow">Results</span>
      <h2 class="hsr-heading">数字で見る、再活用支援の実績</h2>
      <div class="hsr-results">
        {resultHighlights.map(r => (
          r.href ? (
            <a href={r.href} class="hsr-result">
              <p class="hsr-result__num">{r.num}</p>
              <p class="hsr-result__text">{r.text}</p>
              <span class="hsr-result__link">事例を見る →</span>
            </a>
          ) : (
            <div class="hsr-result">
              <p class="hsr-result__num">{r.num}</p>
              <p class="hsr-result__text">{r.text}</p>
            </div>
          )
        ))}
      </div>
    </div>
  </section>

  <!-- 4. 使われない本当の原因 -->
  <section class="hsr-section hsr-section--soft">
    <div class="container">
      <span class="hsr-eyebrow">Root Causes</span>
      <h2 class="hsr-heading">HubSpotが使われなくなる原因は、ツールではなく組織にあります</h2>
      <p class="hsr-lead">200社以上の活用状況を見てきた結論として、定着しない原因はほぼ次の5つに集約されます。裏を返せば、ここに正しく手を打てば立て直せるということです。</p>
      <div class="hsr-causes">
        {causes.map((c, i) => (
          <div class="hsr-cause">
            <div class="hsr-cause__num">{i + 1}</div>
            <div>
              <h3 class="hsr-cause__title">{c.title}</h3>
              <p class="hsr-cause__text">{c.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. 特徴 -->
  <section class="hsr-section">
    <div class="container">
      <span class="hsr-eyebrow">Features</span>
      <h2 class="hsr-heading">Harekaの再活用支援の特徴</h2>
      <div class="hsr-features">
        {features.map((f, i) => (
          <div class="hsr-feature">
            <span class="hsr-feature__num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="hsr-feature__title">{f.title}</h3>
            <p class="hsr-feature__text">{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. 進め方 -->
  <section class="hsr-section hsr-section--soft">
    <div class="container">
      <span class="hsr-eyebrow">Process</span>
      <h2 class="hsr-heading">支援の進め方（4ステップ）</h2>
      <div class="hsr-steps">
        {steps.map(step => (
          <div class="hsr-step">
            <div class="hsr-step__head">
              <div class="hsr-step__num">{step.num}</div>
              <h3 class="hsr-step__title">ステップ{Number(step.num)}: {step.title}</h3>
            </div>
            <div class="hsr-step__body">
              <p>{step.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. 期間と関わり方 -->
  <section class="hsr-section">
    <div class="container">
      <span class="hsr-eyebrow">Timeline</span>
      <h2 class="hsr-heading">期間と関わり方</h2>
      <div class="hsr-period">
        <p>支援期間は最短3ヶ月から。長いケースでは2年にわたり継続支援した実績もあります。基本の進め方は、2週間に1回の定例ミーティングと、その間の構築作業の並行です。月次での伴走支援の形をとることもあります。</p>
        <p>期間の縛りは設けていません。スポット支援や月次契約でのスモールスタートも歓迎です。まずは小さく始めて、成果を確認しながら進められます。</p>
        <p>なお、効果が見え始めるまでの目安は少なくとも3ヶ月、一般的には半年から1年です。短期間で劇的に変わるものではない分、正しく積み上げれば確実に変わります。</p>
      </div>
    </div>
  </section>

  <!-- 8. 支援の前提条件 -->
  <section class="hsr-section hsr-section--soft">
    <div class="container">
      <span class="hsr-eyebrow">Prerequisites</span>
      <h2 class="hsr-heading">お受けする前に、2つだけ確認させてください</h2>
      <p class="hsr-lead">200社を見てきた経験から言えるのは、次の2つが揃わない状態では、外部の誰が支援しても活用は定着しないということです。だからHarekaでは、この2点を支援開始の前提条件とさせていただいています。</p>
      <div class="hsr-conditions">
        <div class="hsr-condition">
          <h3 class="hsr-condition__title">条件1: 経営層のコミットメント</h3>
          <p class="hsr-condition__text">経営層が「HubSpotは使わない」と言い切っている状態では、活用を進めることは極めて困難です。トップの支持は、現場を動かす前提になります。</p>
        </div>
        <div class="hsr-condition">
          <h3 class="hsr-condition__title">条件2: 社内の推進担当者のアサイン</h3>
          <p class="hsr-condition__text">経営層と私たちの間で合意ができていても、現場に推進役がいなければ、外部の人間がどれだけアプローチしても浸透しません。</p>
        </div>
      </div>
      <p class="hsr-conditions-close">逆に、この2つさえ揃えば、現状がどれだけ「使われていない」状態でも立て直せます。「揃えられるか分からない」という段階のご相談も歓迎です。揃え方からご一緒に設計します。</p>
    </div>
  </section>

  <!-- 9. FAQ -->
  <section class="hsr-section">
    <div class="container">
      <span class="hsr-eyebrow">FAQ</span>
      <h2 class="hsr-heading">よくあるご質問</h2>
      <div class="hsr-faq">
        {faqItems.map(item => (
          <div class="hsr-faq__item">
            <h3 class="hsr-faq__q">{item.q}</h3>
            <p class="hsr-faq__a">{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 10. 事例 -->
  <section class="hsr-section hsr-section--soft">
    <div class="container">
      <span class="hsr-eyebrow">Case Studies</span>
      <h2 class="hsr-heading">再活用支援の実績</h2>
      <p class="hsr-lead">「ほぼ使われていない」状態からの立て直しを、業種を問わず支援してきました。</p>
      <div class="hsr-cases-grid">
        {reactivationCases.map(c => (
          <a href={`/cases/${c.slug}/`} class="hsr-case-card">
            <div class="hsr-case-card__tags">
              {(c.data.products ?? []).map((p: string) => (
                <span class="hsr-case-card__tag">{p}</span>
              ))}
            </div>
            <h3 class="hsr-case-card__title">{c.data.title}</h3>
            <p class="hsr-case-card__industry">{c.data.industry}</p>
          </a>
        ))}
      </div>
      <div class="hsr-cases-more">
        <a href="/cases/" class="hsr-cases-more__link">すべての事例を見る →</a>
      </div>
    </div>
  </section>

  <!-- 11. 最終CTA -->
  <section class="hsr-final-cta">
    <div class="container">
      <div class="hsr-final-cta__inner">
        <h2 class="hsr-final-cta__title">まずは1時間の無料相談で、現状を診断します</h2>
        <p class="hsr-final-cta__text">「立て直したいが、何から手を付ければいいか分からない」という段階で構いません。1時間の相談で、現状の利用状況と課題を伺った上で、活用の余地・取り組むべき順番・進め方の見立てをお返しします。無理な売り込みは行いません。前提条件が揃っていない場合は、その揃え方からお伝えします。</p>
        <p class="hsr-final-cta__subtitle">相談で持ち帰っていただけるもの</p>
        <ul class="hsr-final-cta__list">
          <li>現在のHubSpotのどこに活用の余地があるかの見立て</li>
          <li>立て直しに取り組むべき順番</li>
          <li>社内を動かすために必要な準備</li>
        </ul>
        <a href="/contact/" class="btn btn--primary btn--lg">無料相談を予約する</a>
      </div>
    </div>
  </section>
</BaseLayout>
