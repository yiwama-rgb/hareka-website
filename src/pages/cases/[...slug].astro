---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('cases', ({ data }) => !data.draft);
  return items.map(item => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await item.render();
const {
  title, company, industry, employees,
  tool_before, tool_after, period, highlight, pubDate, description, heroImage,
  products, supportType, implementation,
} = item.data;

const formattedDate = pubDate.toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title={`${title} | Hareka 事例`}
  description={description}
  ogTitle={title}
  ogDescription={description}
  ogType="article"
  ogUrl={`https://hareka.io/cases/${item.slug}/`}
>
  <div class="case-outer">
    <div class="case-container">
      <main class="case-main">

        {heroImage && (
          <img class="case-hero" src={heroImage} alt={title} width="820" height="400" />
        )}

        <!-- メタ -->
        <div class="case-meta-bar">
          <span class="case-meta-cat">{company}</span>
          <span class="case-meta-divider">|</span>
          <time class="case-meta-date" datetime={pubDate.toISOString()}>{formattedDate}</time>
        </div>

        {(products || supportType || implementation) && (
          <div class="case-tags">
            {products?.map(p => (
              <span class="case-tag case-tag--product">{p}</span>
            ))}
            {supportType?.map(s => (
              <span class="case-tag case-tag--support">{s}</span>
            ))}
            {implementation && (
              <span class="case-tag case-tag--impl">{implementation}</span>
            )}
          </div>
        )}

        <h1 class="case-title">{title}</h1>

        <!-- ハイライト -->
        <p class="case-highlight">🎯 {highlight}</p>

        <!-- 事例概要パネル -->
        <dl class="case-facts">
          <div class="case-facts__row"><dt>業種</dt><dd>{industry}</dd></div>
          <div class="case-facts__row"><dt>従業員規模</dt><dd>{employees}</dd></div>
          <div class="case-facts__row"><dt>移行前ツール</dt><dd>{tool_before}</dd></div>
          <div class="case-facts__row"><dt>移行後ツール</dt><dd>{tool_after}</dd></div>
          <div class="case-facts__row"><dt>支援期間</dt><dd>{period}</dd></div>
          <div class="case-facts__row"><dt>一番の成果</dt><dd>{highlight}</dd></div>
        </dl>

        <!-- 本文 -->
        <div class="prose">
          <Content />
        </div>

        <!-- 戻るリンク -->
        <div class="case-footer-nav">
          <a href="/cases/" class="case-back-link">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
            支援実績一覧に戻る
          </a>
        </div>
      </main>
    </div>
  </div>

  <!-- 下部 CTA バナー -->
  <section class="cta-banner">
    <div class="container">
      <div class="cta-banner__inner">
        <div>
          <h2 class="cta-banner__title">自社でも同じことができるか相談したい</h2>
          <p class="cta-banner__text">CRM導入・移管・活用のご相談を承っています。</p>
        </div>
        <a href="/contact/" class="btn btn--blue btn--lg">無料相談を申し込む</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .case-outer {
    background: #f8fafc;
    padding: 40px 0 80px;
    margin-top: 76px;
  }
  .case-container {
    max-width: 820px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .case-main {
    background: #fff;
    border-radius: 12px;
    padding: 44px 52px;
    box-shadow: 0 2px 20px rgba(0,0,0,0.05);
  }
  .case-hero {
    display: block;
    width: 100%;
    height: 400px;
    object-fit: cover;
    border-radius: 10px;
    margin-bottom: 28px;
  }
  .case-meta-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    font-size: 13px;
    color: #64748b;
    margin-bottom: 18px;
  }
  .case-meta-cat {
    background: #E8F0F2;
    color: #1B3B47;
    font-weight: 700;
    padding: 3px 12px;
    border-radius: 20px;
    font-size: 12px;
  }
  .case-meta-divider { color: #cbd5e1; }
  .case-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 16px;
  }
  .case-tag {
    font-size: 12px;
    padding: 2px 8px;
    border-radius: 9999px;
    color: #fff;
    font-weight: 600;
    line-height: 1.6;
  }
  .case-tag--product { background: #1D9E75; }
  .case-tag--support { background: #F59E0B; }
  .case-tag--impl { background: #6B7280; }
  .case-title {
    font-size: clamp(22px, 3.5vw, 30px);
    font-weight: 800;
    color: #1B3B47;
    line-height: 1.45;
    margin-bottom: 18px;
    letter-spacing: -0.02em;
  }
  .case-highlight {
    display: inline-block;
    padding: 8px 18px;
    background: rgba(27, 59, 71,.12);
    border-radius: 24px;
    font-size: 15px;
    color: #1B3B47;
    font-weight: 700;
    margin-bottom: 28px;
  }
  .case-facts {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 8px 24px;
    margin-bottom: 36px;
  }
  .case-facts__row {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid #e8edf3;
  }
  .case-facts__row:last-child { border-bottom: none; }
  .case-facts dt {
    font-size: 13px;
    font-weight: 700;
    color: #1B3B47;
  }
  .case-facts dd {
    font-size: 14px;
    color: #374151;
    margin: 0;
  }
  .case-footer-nav {
    border-top: 1px solid #e2e8f0;
    padding-top: 20px;
    margin-top: 32px;
  }
  .case-back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: #1B3B47;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.15s;
  }
  .case-back-link:hover { color: #1B3B47; }

  @media (max-width: 768px) {
    .case-outer { padding: 20px 0 60px; }
    .case-main { padding: 28px 22px; }
    .case-hero { height: 220px; margin-bottom: 22px; }
    .case-facts__row { grid-template-columns: 100px 1fr; gap: 8px; }
  }
</style>

<style is:global>
/* CASE DETAIL — Prose Styles */
.prose {
  font-size: 16px;
  line-height: 1.95;
  color: #374151;
  word-break: break-word;
  overflow-wrap: break-word;
}
.prose > h1:first-child { margin-top: 0; }
.prose h1 {
  font-size: 1.55em;
  font-weight: 800;
  color: #1B3B47;
  line-height: 1.45;
  margin: 1.4em 0 0.8em;
}
.prose p { margin-bottom: 1.5em; }
.prose h2 {
  font-size: 1.35em;
  font-weight: 800;
  color: #1B3B47;
  margin: 2.2em 0 0.8em;
  padding: 0.6em 1em 0.6em 1.1em;
  border-left: 4px solid #1B3B47;
  background: linear-gradient(90deg, #E8F0F2 0%, rgba(232,240,242,0) 100%);
  border-radius: 0 6px 6px 0;
  line-height: 1.4;
}
.prose h3 {
  font-size: 1.12em;
  font-weight: 700;
  color: #1B3B47;
  margin: 1.8em 0 0.6em;
  padding: 0.3em 0 0.3em 0.9em;
  border-left: 3px solid #1B3B47;
  line-height: 1.5;
}
.prose ul { list-style: none; padding-left: 0; margin-bottom: 1.5em; }
.prose ul li { padding-left: 1.4em; position: relative; margin-bottom: 0.5em; line-height: 1.8; }
.prose ul li::before {
  content: ''; position: absolute; left: 0; top: 0.75em;
  width: 6px; height: 6px; background: #1B3B47; border-radius: 50%;
}
.prose strong {
  color: #1B3B47; font-weight: 700;
  background: linear-gradient(transparent 60%, rgba(27, 59, 71,0.15) 60%);
}
.prose blockquote {
  border-left: 4px solid #1B3B47;
  padding: 1.2em 1.4em; margin: 1.6em 0;
  background: #E8F0F2; border-radius: 0 8px 8px 0; color: #1B3B47;
}
.prose blockquote p { margin-bottom: 0; }
.prose table {
  width: 100%; border-collapse: collapse; margin: 1.6em 0;
  font-size: 0.95em; border-radius: 8px; overflow: hidden; border: 1px solid #e2e8f0;
}
.prose th {
  background: #1B3B47; color: #fff; padding: 10px 14px; text-align: left; font-weight: 600;
}
.prose td { padding: 10px 14px; border-bottom: 1px solid #e2e8f0; color: #374151; }
.prose tr:last-child td { border-bottom: none; }
.prose tr:nth-child(even) td { background: #f8fafc; }
.prose hr { border: none; border-top: 2px solid #e2e8f0; margin: 2.2em 0; }
</style>
